+"""HTTP-level tests for team tagline API behavior."""
+
+import json
+from typing import Any
+
+import pytest
+from fastapi import FastAPI
+from flow_res import is_ok
+from injector import Injector
+from starlette.types import ASGIApp, Message, Scope
+
+from app.application.mediator import (
+    ApplicationMediator,
+    create_application_mediator,
+)
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.value_objects import TeamName
+from app.presentation.api.routers import teams
+
+
+async def _request(
+    app: ASGIApp,
+    method: str,
+    path: str,
+    payload: dict[str, object] | None = None,
+) -> tuple[int, Any]:
+    """Send one JSON request through the application's ASGI router."""
+    body = b"" if payload is None else json.dumps(payload).encode()
+    scope: Scope = {
+        "type": "http",
+        "asgi": {"version": "3.0", "spec_version": "2.3"},
+        "http_version": "1.1",
+        "method": method,
+        "scheme": "http",
+        "path": path,
+        "raw_path": path.encode(),
+        "query_string": b"",
+        "root_path": "",
+        "headers": [
+            (b"host", b"testserver"),
+            (b"content-type", b"application/json"),
+            (b"content-length", str(len(body)).encode()),
+        ],
+        "client": ("testclient", 123),
+        "server": ("testserver", 80),
+    }
+    messages: list[Message] = []
+    has_sent_request = False
+
+    async def receive() -> Message:
+        nonlocal has_sent_request
+        if has_sent_request:
+            return {"type": "http.disconnect"}
+        has_sent_request = True
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    await app(scope, receive, send)
+    status = next(
+        message["status"]
+        for message in messages
+        if message["type"] == "http.response.start"
+    )
+    response_body = b"".join(
+        message.get("body", b"")
+        for message in messages
+        if message["type"] == "http.response.body"
+    )
+    return status, json.loads(response_body)
+
+
+@pytest.mark.anyio
+async def test_team_tagline_routes_validate_and_return_persisted_value(
+    uow: IUnitOfWork,
+) -> None:
+    """GET and PUT expose the tagline with the established error statuses."""
+    team = Team.form(TeamName("Team"))
+    async with uow:
+        repository = uow.GetRepository(Team)
+        add_result = await repository.add(team)
+        assert is_ok(add_result)
+        assert is_ok(await uow.commit())
+
+    injector = Injector()
+    injector.binder.bind(IUnitOfWork, to=uow)
+    mediator: ApplicationMediator = create_application_mediator(injector)
+    app = FastAPI()
+    app.state.mediator = mediator
+    app.include_router(teams.router)
+    path = f"/teams/{team.id.to_primitive()}"
+
+    status, initial = await _request(app, "GET", path)
+    assert status == 200
+    assert initial["tagline"] == ""
+
+    tagline = "  First line\nSecond line  "
+    status, update = await _request(app, "PUT", f"{path}/tagline", {"tagline": tagline})
+    assert status == 200
+    assert update == {"id": team.id.to_primitive()}
+
+    status, fetched = await _request(app, "GET", path)
+    assert status == 200
+    assert fetched["tagline"] == tagline
+
+    status, invalid = await _request(
+        app, "PUT", f"{path}/tagline", {"tagline": "x" * 161}
+    )
+    assert status == 400
+    assert "160 characters" in invalid["detail"]
+
+    status, missing = await _request(app, "PUT", f"{path}/tagline", {})
+    assert status == 422
+    assert missing["detail"]
+
+    status, wrong_type = await _request(app, "PUT", f"{path}/tagline", {"tagline": 12})
+    assert status == 422
+    assert wrong_type["detail"]
+
+    status, not_found = await _request(
+        app,
+        "PUT",
+        "/teams/01ARZ3NDEKTSV4RRFFQ69G5FAV/tagline",
+        {"tagline": "Introduction"},
+    )
+    assert status == 404
+    assert not_found["detail"]
