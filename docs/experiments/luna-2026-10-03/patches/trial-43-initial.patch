@@ -0,0 +1,81 @@
+"""Change a team's tagline use case."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, combine_all, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.value_objects import TeamId, TeamTagline
+from app.usecases.result import ErrorType, UseCaseError, UseCaseResultError
+
+
+@dataclass(frozen=True)
+class ChangeTeamTaglineResult:
+    """Result returned after a team's tagline has been changed."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class ChangeTeamTaglineCommand(
+    Request[Result[ChangeTeamTaglineResult, UseCaseResultError]]
+):
+    """Command to replace the tagline of an existing team."""
+
+    team_id: str
+    tagline: str
+
+
+class ChangeTeamTaglineHandler(
+    RequestHandler[
+        ChangeTeamTaglineCommand,
+        Result[ChangeTeamTaglineResult, UseCaseResultError],
+    ]
+):
+    """Handle tagline changes for existing teams."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: ChangeTeamTaglineCommand
+    ) -> Result[ChangeTeamTaglineResult, UseCaseResultError]:
+        """Validate and persist a replacement team tagline."""
+        combined_result = combine_all(
+            (
+                TeamId.from_primitive(request.team_id),
+                TeamTagline.from_primitive(request.tagline),
+            )
+        ).map_err(
+            lambda errors: UseCaseError(
+                type=ErrorType.VALIDATION_ERROR,
+                message=", ".join(str(error) for error in errors.exceptions),
+            )
+        )
+        if is_err(combined_result):
+            return Err(combined_result.error)
+
+        team_id, tagline = combined_result.unwrap()
+        async with self._uow:
+            team_repo = self._uow.GetRepository(Team, TeamId)
+            get_result = await team_repo.get_by_id(team_id)
+            if is_err(get_result):
+                return Err(get_result.error)
+
+            team = get_result.unwrap()
+            team.change_tagline(tagline)
+
+            update_result = await team_repo.update(team)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+            updated_team = update_result.unwrap()
+            return Ok(ChangeTeamTaglineResult(id=updated_team.id.to_primitive()))
