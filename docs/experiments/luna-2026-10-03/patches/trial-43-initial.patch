@@ -0,0 +1,40 @@
+"""Team tagline value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class TeamTagline:
+    """An immutable team tagline that preserves its original whitespace."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 160
+
+    def __post_init__(self) -> None:
+        """Validate the tagline length without normalizing its contents."""
+        if not isinstance(self._value, str):  # type: ignore[reportUnnecessaryIsInstance]
+            raise TypeError("Team tagline must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(
+                f"Team tagline must not exceed {self.MAX_LENGTH} characters."
+            )
+
+    def to_primitive(self) -> str:
+        """Return the exact tagline string for storage or presentation."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["TeamTagline", Exception]:
+        """Create a validated tagline from a string value."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the tagline text."""
+        return self._value
