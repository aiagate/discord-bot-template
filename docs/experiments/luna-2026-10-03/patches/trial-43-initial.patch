+"""Tests for changing and persisting a team's tagline."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import TeamId, TeamName
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.teams.change_team_tagline import (
+    ChangeTeamTaglineCommand,
+    ChangeTeamTaglineHandler,
+)
+from app.usecases.teams.update_team import UpdateTeamCommand, UpdateTeamHandler
+
+
+@pytest.mark.anyio
+async def test_change_tagline_persists_across_unit_of_work_and_rename(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A saved tagline survives a separate UoW reload and later name change."""
+    team = Team.form(TeamName("Original name"))
+    async with uow:
+        repository = uow.GetRepository(Team)
+        add_result = await repository.add(team)
+        assert is_ok(add_result)
+        assert is_ok(await uow.commit())
+
+    command = ChangeTeamTaglineCommand(
+        team_id=team.id.to_primitive(), tagline="  First line\nSecond line  "
+    )
+    result = await ChangeTeamTaglineHandler(uow).handle(command)
+    assert is_ok(result)
+    assert result.value.id == team.id.to_primitive()
+
+    rename_result = await UpdateTeamHandler(uow).handle(
+        UpdateTeamCommand(team_id=team.id.to_primitive(), new_name="Renamed")
+    )
+    assert is_ok(rename_result)
+
+    another_uow = SQLAlchemyUnitOfWork(session_factory)
+    async with another_uow:
+        repository = another_uow.GetRepository(Team, TeamId)
+        get_result = await repository.get_by_id(team.id)
+        assert is_ok(get_result)
+        restored = get_result.value
+        assert restored.name.to_primitive() == "Renamed"
+        assert restored.tagline.to_primitive() == "  First line\nSecond line  "
+
+
+@pytest.mark.anyio
+async def test_invalid_tagline_does_not_change_persisted_team(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A too-long tagline fails validation without changing stored state."""
+    team = Team.form(TeamName("Team"))
+    async with uow:
+        repository = uow.GetRepository(Team)
+        assert is_ok(await repository.add(team))
+        assert is_ok(await uow.commit())
+
+    result = await ChangeTeamTaglineHandler(uow).handle(
+        ChangeTeamTaglineCommand(team_id=team.id.to_primitive(), tagline="x" * 161)
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    another_uow = SQLAlchemyUnitOfWork(session_factory)
+    async with another_uow:
+        repository = another_uow.GetRepository(Team, TeamId)
+        get_result = await repository.get_by_id(team.id)
+        assert is_ok(get_result)
+        assert get_result.value.tagline.to_primitive() == ""
+        assert get_result.value.version.to_primitive() == 0
+
+
+@pytest.mark.anyio
+async def test_change_tagline_returns_not_found_without_creating_team(
+    uow: IUnitOfWork,
+) -> None:
+    """Changing an unknown team returns the repository not-found error."""
+    result = await ChangeTeamTaglineHandler(uow).handle(
+        ChangeTeamTaglineCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV", tagline="Introduction"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_failed_tagline_save_does_not_commit() -> None:
+    """A repository update error exits without committing the UoW."""
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_repo = MagicMock()
+    mock_team = Team.form(TeamName("Team"))
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(mock_team))
+    mock_repo.update = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Database write failed",
+            )
+        )
+    )
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock()
+
+    result = await ChangeTeamTaglineHandler(mock_uow).handle(
+        ChangeTeamTaglineCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV", tagline="Introduction"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.UNEXPECTED
+    mock_uow.commit.assert_not_awaited()
