+++ b/src/app/domain/value_objects/team_description.py
@@ -0,0 +1,44 @@
+"""Team description value object with length validation."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True, slots=True)
+class TeamDescription:
+    """An exact team description, including whitespace and line breaks."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 2000
+
+    def __post_init__(self) -> None:
+        """Validate the description without normalizing its content."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("Team description must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(
+                f"Team description must not exceed {self.MAX_LENGTH} characters."
+            )
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result[TeamDescription, Exception]:
+        """Create a description from its stored or submitted string value."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def to_primitive(self) -> str:
+        """Return the exact string stored in this value object."""
+        return self._value
+
+    def __str__(self) -> str:
+        """Return the description text."""
+        return self._value
