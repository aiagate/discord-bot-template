+"""HTTP-level tests for the teams API router."""
+
+import json
+from typing import cast
+
+import pytest
+from fastapi import FastAPI
+from injector import Injector
+from starlette.types import ASGIApp, Message, Scope
+
+from app import container
+from app.application.mediator import ApplicationMediator
+from app.presentation.api.routers import teams
+
+
+def _teams_app() -> FastAPI:
+    """Build the teams router with the test database's application services."""
+    api = FastAPI()
+    api.include_router(teams.router)
+    injector = Injector([container.configure])
+    api.state.mediator = injector.get(ApplicationMediator)
+    return api
+
+
+async def _request(
+    api: FastAPI,
+    method: str,
+    path: str,
+    payload: dict[str, object] | None = None,
+) -> tuple[int, dict[str, object]]:
+    """Send one JSON request through the ASGI router and return its response."""
+    body = b"" if payload is None else json.dumps(payload).encode()
+    messages: list[Message] = []
+    request_messages = [{"type": "http.request", "body": body, "more_body": False}]
+
+    async def receive() -> Message:
+        if request_messages:
+            return cast(Message, request_messages.pop(0))
+        return {"type": "http.disconnect"}
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    scope: Scope = {
+        "type": "http",
+        "asgi": {"version": "3.0", "spec_version": "2.3"},
+        "http_version": "1.1",
+        "method": method,
+        "scheme": "http",
+        "path": path,
+        "raw_path": path.encode(),
+        "query_string": b"",
+        "root_path": "",
+        "headers": [(b"host", b"testserver"), (b"content-type", b"application/json")],
+        "client": ("127.0.0.1", 12345),
+        "server": ("testserver", 80),
+    }
+    app = cast(ASGIApp, api)
+    await app(scope, receive, send)
+
+    status_message = next(
+        message for message in messages if message["type"] == "http.response.start"
+    )
+    body_message = next(
+        message for message in messages if message["type"] == "http.response.body"
+    )
+    status_code = cast(int, status_message["status"])
+    response_body = cast(bytes, body_message.get("body", b""))
+    response_json = cast(dict[str, object], json.loads(response_body))
+    return status_code, response_json
+
+
+@pytest.mark.anyio
+async def test_team_description_api_lifecycle(session_factory: object) -> None:
+    """Create, fetch, replace, and retain descriptions through HTTP routes."""
+    api = _teams_app()
+
+    create_status, created = await _request(api, "POST", "/teams", {"name": "Original"})
+    assert create_status == 200
+    team_id = cast(str, created["id"])
+
+    get_status, team = await _request(api, "GET", f"/teams/{team_id}")
+    assert get_status == 200
+    assert team["description"] == ""
+
+    missing_status, _ = await _request(api, "PUT", f"/teams/{team_id}/description", {})
+    assert missing_status == 422
+    wrong_type_status, _ = await _request(
+        api, "PUT", f"/teams/{team_id}/description", {"description": 123}
+    )
+    assert wrong_type_status == 422
+
+    empty_status, empty_result = await _request(
+        api, "PUT", f"/teams/{team_id}/description", {"description": ""}
+    )
+    assert empty_status == 200
+    assert empty_result == {"id": team_id}
+
+    description = "  first line\nsecond line\t "
+    update_status, updated = await _request(
+        api,
+        "PUT",
+        f"/teams/{team_id}/description",
+        {"description": description},
+    )
+    assert update_status == 200
+    assert updated == {"id": team_id}
+
+    rename_status, _ = await _request(
+        api, "PUT", f"/teams/{team_id}", {"name": "Renamed"}
+    )
+    assert rename_status == 200
+
+    get_status, team = await _request(api, "GET", f"/teams/{team_id}")
+    assert get_status == 200
+    assert team["name"] == "Renamed"
+    assert team["description"] == description
+
+    too_long_status, _ = await _request(
+        api,
+        "PUT",
+        f"/teams/{team_id}/description",
+        {"description": "x" * 2001},
+    )
+    assert too_long_status == 400
+    get_status, team = await _request(api, "GET", f"/teams/{team_id}")
+    assert get_status == 200
+    assert team["description"] == description
+
+
+@pytest.mark.anyio
+async def test_unknown_team_description_route_returns_not_found(
+    session_factory: object,
+) -> None:
+    """A description update for an unknown ID never creates a team."""
+    api = _teams_app()
+    team_id = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+
+    update_status, _ = await _request(
+        api,
+        "PUT",
+        f"/teams/{team_id}/description",
+        {"description": "Description"},
+    )
+    assert update_status == 404
+
+    get_status, _ = await _request(api, "GET", f"/teams/{team_id}")
+    assert get_status == 404
