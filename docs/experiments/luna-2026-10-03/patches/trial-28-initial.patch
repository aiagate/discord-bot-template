+"""Tests for replacing a team's description."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import TeamName
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.teams.get_team import GetTeamHandler, GetTeamQuery
+from app.usecases.teams.update_team import UpdateTeamCommand, UpdateTeamHandler
+from app.usecases.teams.update_team_description import (
+    UpdateTeamDescriptionCommand,
+    UpdateTeamDescriptionHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_description_persists_across_units_of_work_and_rename(
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Descriptions persist across UoWs and survive a later name change."""
+    create_uow = SQLAlchemyUnitOfWork(session_factory)
+    team = Team.form(name=TeamName("Initial team"))
+    async with create_uow:
+        add_result = await create_uow.GetRepository(Team).add(team)
+        assert is_ok(add_result)
+        team_id = add_result.value.id.to_primitive()
+        assert is_ok(await create_uow.commit())
+
+    description = "  first line\nsecond line\t "
+    handler = UpdateTeamDescriptionHandler(SQLAlchemyUnitOfWork(session_factory))
+    update_result = await handler.handle(
+        UpdateTeamDescriptionCommand(team_id=team_id, description=description)
+    )
+    assert is_ok(update_result)
+
+    read_handler = GetTeamHandler(SQLAlchemyUnitOfWork(session_factory))
+    read_result = await read_handler.handle(GetTeamQuery(id=team_id))
+    assert is_ok(read_result)
+    assert read_result.value.description == description
+
+    rename_handler = UpdateTeamHandler(SQLAlchemyUnitOfWork(session_factory))
+    rename_result = await rename_handler.handle(
+        UpdateTeamCommand(team_id=team_id, new_name="Renamed team")
+    )
+    assert is_ok(rename_result)
+
+    read_result = await read_handler.handle(GetTeamQuery(id=team_id))
+    assert is_ok(read_result)
+    assert read_result.value.name == "Renamed team"
+    assert read_result.value.description == description
+
+
+@pytest.mark.anyio
+async def test_invalid_description_does_not_change_persisted_team(
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Overlong text is rejected before any database update is committed."""
+    create_uow = SQLAlchemyUnitOfWork(session_factory)
+    team = Team.form(name=TeamName("Team"))
+    async with create_uow:
+        add_result = await create_uow.GetRepository(Team).add(team)
+        assert is_ok(add_result)
+        team_id = add_result.value.id.to_primitive()
+        assert is_ok(await create_uow.commit())
+
+    handler = UpdateTeamDescriptionHandler(SQLAlchemyUnitOfWork(session_factory))
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(team_id=team_id, description="x" * 2001)
+    )
+    assert is_err(result)
+    assert result.error.type is ErrorType.VALIDATION_ERROR
+
+    read_result = await GetTeamHandler(SQLAlchemyUnitOfWork(session_factory)).handle(
+        GetTeamQuery(id=team_id)
+    )
+    assert is_ok(read_result)
+    assert read_result.value.description == ""
+
+
+@pytest.mark.anyio
+async def test_description_update_returns_not_found_without_creating_team(
+    uow: IUnitOfWork,
+) -> None:
+    """An unknown valid ID follows the repository's NOT_FOUND contract."""
+    handler = UpdateTeamDescriptionHandler(uow)
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            description="Description",
+        )
+    )
+    assert is_err(result)
+    assert result.error.type is RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_description_save_failure_does_not_commit() -> None:
+    """A repository update error is returned without committing the UoW."""
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_repo = MagicMock()
+    mock_team = Team.form(name=TeamName("Original"))
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(mock_team))
+    mock_repo.update = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Database write failed",
+            )
+        )
+    )
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock()
+
+    handler = UpdateTeamDescriptionHandler(mock_uow)
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            description="New description",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type is RepositoryErrorType.UNEXPECTED
+    mock_uow.commit.assert_not_awaited()
