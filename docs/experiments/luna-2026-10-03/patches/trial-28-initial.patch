+"""Tests for team description validation and exact value preservation."""
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import TeamDescription
+
+
+def test_description_allows_empty_and_preserves_whitespace() -> None:
+    """Empty descriptions are valid and other text remains unnormalized."""
+    empty = TeamDescription.from_primitive("").expect("empty description is valid")
+    assert empty == TeamDescription("")
+
+    original = " \tLine one\nLine two  "
+    description = TeamDescription.from_primitive(original).expect("valid description")
+    assert description.to_primitive() == original
+
+
+def test_description_accepts_maximum_length() -> None:
+    """A description at the 2,000-character limit is valid."""
+    result = TeamDescription.from_primitive("x" * TeamDescription.MAX_LENGTH)
+    assert is_ok(result)
+    assert len(result.value.to_primitive()) == 2000
+
+
+def test_description_rejects_values_over_maximum_length() -> None:
+    """A description longer than 2,000 characters is invalid."""
+    result = TeamDescription.from_primitive("x" * (TeamDescription.MAX_LENGTH + 1))
+    assert is_err(result)
+    assert "must not exceed 2000 characters" in str(result.error)
+
+
+def test_description_rejects_non_string_values() -> None:
+    """The value object rejects values that are not strings."""
+    with pytest.raises(TypeError, match="must be a string"):
+        TeamDescription(1)  # type: ignore[arg-type]
