@@ -0,0 +1,42 @@
+"""TeamTagline value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class TeamTagline:
+    """An immutable tagline that preserves text exactly as entered."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 160
+
+    def __post_init__(self) -> None:
+        """Require a string no longer than the configured maximum."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("Team tagline must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(
+                f"Team tagline must not exceed {self.MAX_LENGTH} characters."
+            )
+
+    def to_primitive(self) -> str:
+        """Return the exact tagline text."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["TeamTagline", Exception]:
+        """Create a validated tagline from a string."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the tagline text."""
+        return self.to_primitive()
