+"""Tests for TeamTagline validation and exact text preservation."""
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import TeamTagline
+
+
+@pytest.mark.parametrize("value", ["", "  \n  ", "line one\nline two\t"])
+def test_tagline_preserves_empty_whitespace_and_newlines(value: str) -> None:
+    result = TeamTagline.from_primitive(value)
+
+    assert is_ok(result)
+    assert result.value.to_primitive() == value
+
+
+def test_tagline_accepts_maximum_length() -> None:
+    tagline = TeamTagline("x" * TeamTagline.MAX_LENGTH)
+
+    assert len(tagline.to_primitive()) == 160
+
+
+def test_tagline_rejects_more_than_maximum_length() -> None:
+    result = TeamTagline.from_primitive("x" * (TeamTagline.MAX_LENGTH + 1))
+
+    assert is_err(result)
+    assert "160 characters" in str(result.error)
+
+
+def test_tagline_rejects_non_string_values() -> None:
+    result = TeamTagline.from_primitive(123)  # type: ignore[arg-type]
+
+    assert is_err(result)
+    assert isinstance(result.error, TypeError)
