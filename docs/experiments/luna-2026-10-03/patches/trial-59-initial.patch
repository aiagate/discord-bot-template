+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            teams.insert().values(
+                id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+                name="Old team",
+                version=0,
+                created_at=datetime(2026, 9, 1, tzinfo=UTC),
+                updated_at=datetime(2026, 9, 1, tzinfo=UTC),
+            )
+        )
+
+        def run_upgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.upgrade()
+
+        await connection.run_sync(run_upgrade)
+        value = (
+            await connection.exec_driver_sql("SELECT tagline FROM teams")
+        ).scalar_one()
+        assert value == ""
+
+        def run_downgrade(sync_connection: sa.Connection) -> set[str]:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.downgrade()
+            return {
+                column["name"]
+                for column in sa.inspect(sync_connection).get_columns("teams")
+            }
+
+        column_names = await connection.run_sync(run_downgrade)
+
+    await engine.dispose()
+    assert "tagline" not in column_names
