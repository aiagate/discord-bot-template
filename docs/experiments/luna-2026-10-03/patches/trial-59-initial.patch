+@pytest.mark.anyio
+async def test_migration_adds_empty_tagline_to_existing_teams_and_downgrades() -> None:
+    """Existing rows receive an empty value and downgrade removes the column."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    teams = sa.Table(
