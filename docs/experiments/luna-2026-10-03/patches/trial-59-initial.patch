+"""Tests for team tagline API behavior."""
+
+from typing import cast
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Ok
+
+from app.application.mediator import ApplicationMediator
+from app.presentation.api.routers.teams import (
+    CreateTeamResponse,
+    TeamResponse,
+    UpdateTeamTaglineRequest,
+    get_team,
+    update_team_tagline,
+)
+from app.usecases.teams.get_team import GetTeamResult
+from app.usecases.teams.update_team_tagline import (
+    UpdateTeamTaglineCommand,
+    UpdateTeamTaglineResult,
+)
+
+
+@pytest.mark.anyio
+async def test_get_team_response_includes_tagline() -> None:
+    """GET returns the tagline from the use-case result."""
+    mediator_mock = MagicMock(spec=ApplicationMediator)
+    mediator_mock.send_async = AsyncMock(
+        return_value=Ok(
+            GetTeamResult(
+                id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+                name="Alpha",
+                tagline="  welcome\n",
+                version=2,
+            )
+        )
+    )
+
+    response = await get_team(
+        "01ARZ3NDEKTSV4RRFFQ69G5FAV", cast(ApplicationMediator, mediator_mock)
+    )
+
+    assert response == TeamResponse(
+        id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+        name="Alpha",
+        tagline="  welcome\n",
+        version=2,
+    )
+
+
+@pytest.mark.anyio
+async def test_put_team_tagline_dispatches_command_and_returns_update_shape() -> None:
+    """PUT accepts a required tagline and uses the existing update response."""
+    team_id = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+    mediator_mock = MagicMock(spec=ApplicationMediator)
+    mediator_mock.send_async = AsyncMock(
+        return_value=Ok(UpdateTeamTaglineResult(id=team_id))
+    )
+
+    response = await update_team_tagline(
+        team_id,
+        UpdateTeamTaglineRequest(tagline="  text\n"),
+        cast(ApplicationMediator, mediator_mock),
+    )
+
+    assert response == CreateTeamResponse(id=team_id)
+    sent_command = mediator_mock.send_async.await_args.args[0]
+    assert sent_command == UpdateTeamTaglineCommand(team_id, "  text\n")
+    assert UpdateTeamTaglineRequest.model_fields["tagline"].is_required()
