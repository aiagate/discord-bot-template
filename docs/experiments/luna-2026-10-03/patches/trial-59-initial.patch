+"""Tests for the update team tagline use case."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import TeamName, TeamTagline
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.teams.get_team import GetTeamHandler, GetTeamQuery
+from app.usecases.teams.update_team import UpdateTeamCommand, UpdateTeamHandler
+from app.usecases.teams.update_team_tagline import (
+    UpdateTeamTaglineCommand,
+    UpdateTeamTaglineHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_tagline_update_persists_exact_text_and_name_update_keeps_it(
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A new UoW reads exact text after update and rename."""
+    uow = SQLAlchemyUnitOfWork(session_factory)
+    team = Team.form(TeamName("Original"))
+    async with uow:
+        assert is_ok(await uow.GetRepository(Team).add(team))
+        assert is_ok(await uow.commit())
+
+    created_team = await GetTeamHandler(SQLAlchemyUnitOfWork(session_factory)).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(created_team)
+    assert created_team.value.tagline == ""
+
+    tagline = "  Welcome to our team!\nSecond line\t "
+    update_result = await UpdateTeamTaglineHandler(uow).handle(
+        UpdateTeamTaglineCommand(team.id.to_primitive(), tagline)
+    )
+    assert is_ok(update_result)
+    assert update_result.value.id == team.id.to_primitive()
+
+    rename_result = await UpdateTeamHandler(uow).handle(
+        UpdateTeamCommand(team_id=team.id.to_primitive(), new_name="Renamed")
+    )
+    assert is_ok(rename_result)
+
+    other_uow = SQLAlchemyUnitOfWork(session_factory)
+    get_result = await GetTeamHandler(other_uow).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(get_result)
+    assert get_result.value.name == "Renamed"
+    assert get_result.value.tagline == tagline
+
+
+@pytest.mark.anyio
+async def test_tagline_update_accepts_empty_text(uow: IUnitOfWork) -> None:
+    """An empty tagline is a valid replacement value."""
+    team = Team.form(TeamName("Alpha"))
+    async with uow:
+        assert is_ok(await uow.GetRepository(Team).add(team))
+        assert is_ok(await uow.commit())
+
+    result = await UpdateTeamTaglineHandler(uow).handle(
+        UpdateTeamTaglineCommand(team.id.to_primitive(), "")
+    )
+
+    assert is_ok(result)
+    loaded = await GetTeamHandler(uow).handle(GetTeamQuery(id=team.id.to_primitive()))
+    assert is_ok(loaded)
+    assert loaded.value.tagline == ""
+
+
+@pytest.mark.anyio
+async def test_tagline_update_rejects_invalid_inputs_without_changing_team(
+    uow: IUnitOfWork,
+) -> None:
+    """Invalid IDs and oversized taglines fail before changing stored state."""
+    team = Team.form(TeamName("Alpha"))
+    team.change_tagline(TeamTagline("original"))
+    async with uow:
+        assert is_ok(await uow.GetRepository(Team).add(team))
+        assert is_ok(await uow.commit())
+
+    handler = UpdateTeamTaglineHandler(uow)
+    invalid_id = await handler.handle(UpdateTeamTaglineCommand("invalid", "valid"))
+    too_long = await handler.handle(
+        UpdateTeamTaglineCommand(team.id.to_primitive(), "x" * 161)
+    )
+    assert is_err(invalid_id) and invalid_id.error.type is ErrorType.VALIDATION_ERROR
+    assert is_err(too_long) and too_long.error.type is ErrorType.VALIDATION_ERROR
+
+    loaded = await GetTeamHandler(uow).handle(GetTeamQuery(id=team.id.to_primitive()))
+    assert is_ok(loaded)
+    assert loaded.value.tagline == "original"
+
+
+@pytest.mark.anyio
+async def test_tagline_update_unknown_team_returns_not_found(uow: IUnitOfWork) -> None:
+    """An unknown team ID is not treated as a request to create a team."""
+    result = await UpdateTeamTaglineHandler(uow).handle(
+        UpdateTeamTaglineCommand("01ARZ3NDEKTSV4RRFFQ69G5FAV", "tagline")
+    )
+
+    assert is_err(result)
+    assert result.error.type is RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_tagline_update_save_failure_does_not_commit() -> None:
+    """A failed repository update is returned without committing the UoW."""
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_repo = MagicMock()
+    team = Team.form(TeamName("Alpha"))
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(team))
+    mock_repo.update = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Database write failed",
+            )
+        )
+    )
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock()
+
+    result = await UpdateTeamTaglineHandler(mock_uow).handle(
+        UpdateTeamTaglineCommand(team.id.to_primitive(), "tagline")
+    )
+
+    assert is_err(result)
+    assert result.error.type is RepositoryErrorType.UNEXPECTED
+    mock_uow.commit.assert_not_awaited()
