+"""Regression checks through Pydantic, routing and the real mediator."""
+
+import json
+from typing import Any
+
+import anyio
+import pytest
+from fastapi import FastAPI
+from injector import Injector
+from starlette.types import Message, Scope
+
+from app import container
+from app.application.mediator import ApplicationMediator
+from app.presentation.api.routers import teams
+
+
+async def request(
+    app: FastAPI, method: str, path: str, payload: dict[str, Any] | None = None
+) -> tuple[int, Any]:
+    """Issue one in-process HTTP request without external services."""
+    body = json.dumps(payload).encode() if payload is not None else b""
+    messages: list[Message] = []
+
+    async def receive() -> Message:
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    scope: Scope = {
+        "type": "http",
+        "asgi": {"version": "3.0"},
+        "http_version": "1.1",
+        "method": method,
+        "scheme": "http",
+        "path": path,
+        "query_string": b"",
+        "headers": [(b"content-type", b"application/json")],
+        "server": ("test", 80),
+        "client": ("test", 1),
+        "root_path": "",
+    }
+    with anyio.fail_after(5):
+        await app(scope, receive, send)
+    status = next(m["status"] for m in messages if m["type"] == "http.response.start")
+    content = b"".join(
+        m.get("body", b"") for m in messages if m["type"] == "http.response.body"
+    )
+    return status, json.loads(content)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "payload, expected_status",
+    [
+        ({"description": "x" * 2001}, 400),
+        ({}, 422),
+        ({"description": None}, 422),
+    ],
+)
+async def test_description_http_validation_preserves_team(
+    test_db_engine: None, payload: dict[str, Any], expected_status: int
+) -> None:
+    """Reject business limits as 400 and malformed bodies as 422, atomically."""
+    app = FastAPI()
+    app.include_router(teams.router)
+    app.state.mediator = Injector([container.configure]).get(ApplicationMediator)
+    status, created = await request(app, "POST", "/teams", {"name": "Before"})
+    assert status == 200
+    path = f"/teams/{created['id']}"
+    status, before = await request(app, "GET", path)
+    assert status == 200
+    status, _ = await request(app, "PUT", path + "/description", payload)
+    assert status == expected_status
+    status, after = await request(app, "GET", path)
+    assert status == 200
+    assert after == before
