@@ -0,0 +1,90 @@
+"""Update a team's description use case."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.value_objects import TeamDescription, TeamId
+from app.usecases.result import (
+    ErrorType,
+    UseCaseError,
+    UseCaseResultError,
+)
+
+
+@dataclass(frozen=True)
+class UpdateTeamDescriptionResult:
+    """Result object for a successful team description update."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class UpdateTeamDescriptionCommand(
+    Request[Result[UpdateTeamDescriptionResult, UseCaseResultError]]
+):
+    """Command to replace an existing team's description."""
+
+    team_id: str
+    description: str
+
+
+class UpdateTeamDescriptionHandler(
+    RequestHandler[
+        UpdateTeamDescriptionCommand,
+        Result[UpdateTeamDescriptionResult, UseCaseResultError],
+    ]
+):
+    """Handler for UpdateTeamDescription command."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: UpdateTeamDescriptionCommand
+    ) -> Result[UpdateTeamDescriptionResult, UseCaseResultError]:
+        """Validate, replace, and persist a team's description."""
+        team_id_result = TeamId.from_primitive(request.team_id)
+        description_result = TeamDescription.from_primitive(request.description)
+
+        if is_err(team_id_result):
+            return Err(
+                UseCaseError(
+                    type=ErrorType.VALIDATION_ERROR,
+                    message=str(team_id_result.error),
+                )
+            )
+        if is_err(description_result):
+            return Err(
+                UseCaseError(
+                    type=ErrorType.VALIDATION_ERROR,
+                    message=str(description_result.error),
+                )
+            )
+
+        team_id = team_id_result.value
+        description = description_result.value
+
+        async with self._uow:
+            team_repo = self._uow.GetRepository(Team, TeamId)
+            get_result = await team_repo.get_by_id(team_id)
+            if is_err(get_result):
+                return Err(get_result.error)
+
+            team = get_result.value
+            team.change_description(description)
+
+            update_result = await team_repo.update(team)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+            return Ok(UpdateTeamDescriptionResult(id=team_id.to_primitive()))
