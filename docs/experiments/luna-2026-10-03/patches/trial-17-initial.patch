+"""Tests for UpdateTeamDescription use case."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import TeamName
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.teams.get_team import GetTeamHandler, GetTeamQuery
+from app.usecases.teams.update_team import UpdateTeamCommand, UpdateTeamHandler
+from app.usecases.teams.update_team_description import (
+    UpdateTeamDescriptionCommand,
+    UpdateTeamDescriptionHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_description_persists_across_units_of_work_and_survives_rename(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Description changes persist and remain after a separate name update."""
+    team = Team.form(name=TeamName("Original name"))
+    async with uow:
+        repo = uow.GetRepository(Team)
+        add_result = await repo.add(team)
+        assert is_ok(add_result)
+        commit_result = await uow.commit()
+        assert is_ok(commit_result)
+
+    team_id = team.id.to_primitive()
+    description = "  First line\nSecond line  "
+    update_handler = UpdateTeamDescriptionHandler(uow)
+    update_result = await update_handler.handle(
+        UpdateTeamDescriptionCommand(team_id=team_id, description=description)
+    )
+    assert is_ok(update_result)
+    assert update_result.value.id == team_id
+
+    independent_uow = SQLAlchemyUnitOfWork(session_factory)
+    get_handler = GetTeamHandler(independent_uow)
+    stored = await get_handler.handle(GetTeamQuery(id=team_id))
+    assert is_ok(stored)
+    assert stored.value.description == description
+
+    rename_result = await UpdateTeamHandler(independent_uow).handle(
+        UpdateTeamCommand(team_id=team_id, new_name="Renamed team")
+    )
+    assert is_ok(rename_result)
+
+    reloaded = await GetTeamHandler(SQLAlchemyUnitOfWork(session_factory)).handle(
+        GetTeamQuery(id=team_id)
+    )
+    assert is_ok(reloaded)
+    assert reloaded.value.name == "Renamed team"
+    assert reloaded.value.description == description
+
+
+@pytest.mark.anyio
+async def test_description_handler_returns_not_found_without_creating_team(
+    uow: IUnitOfWork,
+) -> None:
+    """An unknown valid ID follows the repository's existing not-found contract."""
+    handler = UpdateTeamDescriptionHandler(uow)
+
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            description="details",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_description_handler_rejects_overlong_input_before_opening_uow() -> None:
+    """Invalid description input does not enter the persistence boundary."""
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    handler = UpdateTeamDescriptionHandler(mock_uow)
+
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            description="x" * 2001,
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    mock_uow.__aenter__.assert_not_awaited()
+
+
+@pytest.mark.anyio
+async def test_description_repository_failure_does_not_commit() -> None:
+    """A failed repository update is returned without committing the UoW."""
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_repo = MagicMock()
+    team = Team.form(name=TeamName("Original name"))
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(team))
+    mock_repo.update = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Database write failed",
+            )
+        )
+    )
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock()
+
+    result = await UpdateTeamDescriptionHandler(mock_uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(), description="details"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.UNEXPECTED
+    mock_uow.commit.assert_not_awaited()
