@@ -0,0 +1,49 @@
+"""Tests for TeamDescription value object."""
+
+import dataclasses
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import TeamDescription
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "  \n\t ", "First line\nSecond line", "x" * 2000],
+)
+def test_team_description_preserves_text_at_valid_boundaries(value: str) -> None:
+    """Descriptions keep empty values, whitespace, newlines, and boundary text."""
+    result = TeamDescription.from_primitive(value)
+
+    assert is_ok(result)
+    assert result.value.to_primitive() == value
+
+
+def test_team_description_rejects_text_over_limit() -> None:
+    """Descriptions longer than 2000 characters are rejected."""
+    result = TeamDescription.from_primitive("x" * 2001)
+
+    assert is_err(result)
+    assert isinstance(result.error, ValueError)
+    with pytest.raises(ValueError, match="must not exceed 2000 characters"):
+        TeamDescription(_value="x" * 2001)
+
+
+@pytest.mark.parametrize("value", [None, 123])
+def test_team_description_rejects_non_string_values(value: object) -> None:
+    """Descriptions must be strings."""
+    with pytest.raises(TypeError, match="must be a string"):
+        TeamDescription(_value=value)  # type: ignore[arg-type]
+
+    result = TeamDescription.from_primitive(value)  # type: ignore[arg-type]
+    assert is_err(result)
+    assert isinstance(result.error, TypeError)
+
+
+def test_team_description_is_immutable() -> None:
+    """Description values cannot be mutated after construction."""
+    description = TeamDescription(_value="details")
+
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        description._value = "changed"  # type: ignore[misc]
