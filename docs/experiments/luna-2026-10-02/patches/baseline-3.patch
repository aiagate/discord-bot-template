+"""Tests for updating a user's complete profile."""
+
+from typing import Any
+
+import pytest
+from flow_res import is_err, is_ok
+from sqlalchemy import event
+from sqlalchemy.engine import Connection
+from sqlalchemy.engine.interfaces import DBAPIConnection, ExecutionContext
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.repositories import RepositoryErrorType
+from app.domain.value_objects import Bio, DisplayName, Email, UserId
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.users.get_user import GetUserHandler, GetUserQuery
+from app.usecases.users.update_user_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_update_profile_persists_both_fields_across_units_of_work(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A later UoW reads the exact profile while email and ID stay unchanged."""
+    user = User.register(DisplayName("Before"), Email("before@example.com"))
+    async with uow:
+        repository = uow.GetRepository(User)
+        saved = await repository.add(user)
+        assert is_ok(saved)
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="After",
+            bio="  about me\nwith a newline  ",
+        )
+    )
+
+    assert is_ok(result)
+    assert result.value.id == user.id.to_primitive()
+
+    second_uow = SQLAlchemyUnitOfWork(session_factory)
+    loaded = await GetUserHandler(second_uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(loaded)
+    assert loaded.value.id == user.id.to_primitive()
+    assert loaded.value.display_name == "After"
+    assert loaded.value.email == "before@example.com"
+    assert loaded.value.bio == "  about me\nwith a newline  "
+
+
+@pytest.mark.anyio
+async def test_update_profile_returns_not_found_for_unknown_user(
+    uow: IUnitOfWork,
+) -> None:
+    """An unknown ID is not inserted by a profile update."""
+    user_id = UserId.generate().expect("valid User ID")
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user_id.to_primitive(),
+            display_name="New User",
+            bio="New profile",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    ("display_name", "bio"),
+    (("", "replacement"), ("Replacement", "x" * 501)),
+)
+async def test_invalid_profile_input_leaves_both_fields_unchanged(
+    uow: IUnitOfWork,
+    display_name: str,
+    bio: str,
+) -> None:
+    """Invalid profile input is rejected before either field is persisted."""
+    user = User.register(DisplayName("Original"), Email("original@example.com"))
+    async with uow:
+        repository = uow.GetRepository(User)
+        saved = await repository.add(user)
+        assert is_ok(saved)
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name=display_name,
+            bio=bio,
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    loaded = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(loaded)
+    assert loaded.value.display_name == "Original"
+    assert loaded.value.bio == ""
+
+
+@pytest.mark.anyio
+async def test_profile_write_failure_rolls_back_both_fields(
+    uow: IUnitOfWork,
+    database_engine: AsyncEngine,
+) -> None:
+    """A database update error leaves the committed profile untouched."""
+    user = User.register(
+        DisplayName("Original"),
+        Email("original@example.com"),
+        Bio("Original bio"),
+    )
+    async with uow:
+        repository = uow.GetRepository(User)
+        saved = await repository.add(user)
+        assert is_ok(saved)
+        assert is_ok(await uow.commit())
+
+    def reject_user_updates(
+        connection: Connection,
+        cursor: DBAPIConnection,
+        statement: str,
+        parameters: Any,
+        context: ExecutionContext,
+        executemany: bool,
+    ) -> None:
+        if statement.lstrip().upper().startswith("UPDATE USERS"):
+            raise IntegrityError(
+                statement, parameters, RuntimeError("simulated write failure")
+            )
+
+    event.listen(
+        database_engine.sync_engine, "before_cursor_execute", reject_user_updates
+    )
+    try:
+        result = await UpdateUserProfileHandler(uow).handle(
+            UpdateUserProfileCommand(
+                user_id=user.id.to_primitive(),
+                display_name="Replacement",
+                bio="Replacement bio",
+            )
+        )
+    finally:
+        event.remove(
+            database_engine.sync_engine, "before_cursor_execute", reject_user_updates
+        )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.ALREADY_EXISTS
+    loaded = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(loaded)
+    assert loaded.value.display_name == "Original"
+    assert loaded.value.bio == "Original bio"
+    assert loaded.value.email == "original@example.com"
