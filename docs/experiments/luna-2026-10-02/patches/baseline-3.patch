index 0000000..28efafc
--- /dev/null
+++ b/src/app/domain/value_objects/bio.py
@@ -0,0 +1,39 @@
+"""Bio value object with length validation that preserves input verbatim."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class Bio:
+    """A profile bio containing between zero and 500 characters."""
+
+    _value: str
+
+    MIN_LENGTH: ClassVar[int] = 0
+    MAX_LENGTH: ClassVar[int] = 500
+
+    def __post_init__(self) -> None:
+        """Validate bio type and length without normalizing its contents."""
+        if not isinstance(self._value, str):  # type: ignore[reportUnnecessaryIsInstance]
+            raise TypeError("Bio must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(f"Bio must not exceed {self.MAX_LENGTH} characters.")
+
+    def to_primitive(self) -> str:
+        """Return the exact string value for application and persistence use."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["Bio", Exception]:
+        """Create a Bio from an external or persisted string value."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the bio text unchanged."""
+        return self.to_primitive()
diff --git a/src/app/usecases/users/update_user_profile.py b/src/app/usecases/users/update_user_profile.py
new file mode 100644
index 0000000..a89d1ae
--- /dev/null
+++ b/src/app/usecases/users/update_user_profile.py
@@ -0,0 +1,85 @@
+"""Update an existing user's profile."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, combine_all, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.value_objects import Bio, DisplayName, UserId
+from app.usecases.result import ErrorType, UseCaseError, UseCaseResultError
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileResult:
+    """Result object for a successful profile update."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileCommand(
+    Request[Result[UpdateUserProfileResult, UseCaseResultError]]
+):
+    """Command containing both required profile fields."""
+
+    user_id: str
+    display_name: str
+    bio: str
+
+
+class UpdateUserProfileHandler(
+    RequestHandler[
+        UpdateUserProfileCommand,
+        Result[UpdateUserProfileResult, UseCaseResultError],
+    ]
+):
+    """Validate, load, and atomically persist a user's profile."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: UpdateUserProfileCommand
+    ) -> Result[UpdateUserProfileResult, UseCaseResultError]:
+        """Update both profile fields for an existing user."""
+        validated = combine_all(
+            (
+                UserId.from_primitive(request.user_id),
+                DisplayName.from_primitive(request.display_name),
+                Bio.from_primitive(request.bio),
+            )
+        ).map_err(
+            lambda errors: UseCaseError(
+                type=ErrorType.VALIDATION_ERROR,
+                message=", ".join(str(error) for error in errors.exceptions),
+            )
+        )
+        if is_err(validated):
+            return Err(validated.error)
+
+        user_id, display_name, bio = validated.unwrap()
+
+        async with self._uow:
+            user_repo = self._uow.GetRepository(User, UserId)
+            get_result = await user_repo.get_by_id(user_id)
+            if is_err(get_result):
+                return Err(get_result.error)
+
+            user = get_result.unwrap()
+            user.change_profile(display_name, bio)
+
+            update_result = await user_repo.update(user)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+            return Ok(
+                UpdateUserProfileResult(id=update_result.unwrap().id.to_primitive())
+            )
diff --git a/tests/infrastructure/test_user_profile_migration.py b/tests/infrastructure/test_user_profile_migration.py
new file mode 100644
index 0000000..643a6e6
--- /dev/null
+++ b/tests/infrastructure/test_user_profile_migration.py
@@ -0,0 +1,88 @@
+"""Tests for adding the bio field to existing user rows."""
+
+import importlib.util
+from pathlib import Path
+from typing import Any
+
+import pytest
+import sqlalchemy as sa
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy.ext.asyncio import create_async_engine
+
+_MIGRATION_PATH = (
+    Path(__file__).parents[2]
+    / "alembic"
+    / "versions"
+    / "202610020900_add_bio_to_users.py"
+)
+
+
+def _load_migration() -> Any:
+    spec = importlib.util.spec_from_file_location("user_bio_migration", _MIGRATION_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("Could not load user bio migration.")
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    return migration
+
+
+@pytest.mark.anyio
+async def test_migration_defaults_existing_bios_and_can_downgrade() -> None:
+    """Existing users receive an empty bio and are preserved through migration."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    users = sa.Table(
+        "users",
+        metadata,
+        sa.Column("id", sa.String(26), primary_key=True),
+        sa.Column("display_name", sa.String(255), nullable=False),
+        sa.Column("email", sa.String(255), nullable=False),
+    )
+    migration = _load_migration()
+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            users.insert(),
+            {"id": "existing-user", "display_name": "Alice", "email": "a@b.co"},
+        )
+
+        def run_upgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.upgrade()
+
+        await connection.run_sync(run_upgrade)
+        rows = (
+            (
+                await connection.execute(
+                    sa.text("SELECT id, display_name, email, bio FROM users")
+                )
+            )
+            .mappings()
+            .all()
+        )
+        assert rows == [
+            {
+                "id": "existing-user",
+                "display_name": "Alice",
+                "email": "a@b.co",
+                "bio": "",
+            }
+        ]
+
+        def run_downgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.downgrade()
+
+        await connection.run_sync(run_downgrade)
+        assert "bio" not in {
+            column["name"]
+            for column in await connection.run_sync(
+                lambda sync_connection: sa.inspect(sync_connection).get_columns("users")
+            )
+        }
+
+    await engine.dispose()
