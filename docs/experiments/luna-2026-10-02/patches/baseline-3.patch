+    with pytest.raises(ValidationError):
+        UpdateUserProfileRequest(display_name="Alice")  # type: ignore[call-arg]
+
+
+@pytest.mark.anyio
+async def test_profile_put_sends_both_fields_and_returns_existing_update_shape() -> (
+    None
+):
+    """The API delegates one complete profile command and returns its ID."""
+    mediator = MagicMock(spec=ApplicationMediator)
+    mediator.send_async = AsyncMock(
+        return_value=Ok(UpdateUserProfileResult(id="user-1"))
+    )
+
+    response = await update_user_profile(
+        "user-1",
+        UpdateUserProfileRequest(display_name="Alice", bio=" about\nme "),
+        mediator,
+    )
+
+    assert isinstance(response, UpdateUserProfileResponse)
+    assert response.id == "user-1"
+    command = mediator.send_async.await_args.args[0]
+    assert command.user_id == "user-1"
+    assert command.display_name == "Alice"
+    assert command.bio == " about\nme "
+
+
+@pytest.mark.anyio
+async def test_get_user_includes_bio() -> None:
+    """GET translates the use-case DTO with bio into its response model."""
+    mediator = MagicMock(spec=ApplicationMediator)
