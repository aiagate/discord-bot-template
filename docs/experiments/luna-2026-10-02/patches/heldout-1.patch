+"""Tests for TeamDescription value object."""
+
+import dataclasses
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects.team_description import TeamDescription
+
+
+@pytest.mark.parametrize("value", ["", "  ", " line one\nline two \n"])
+def test_description_accepts_empty_and_preserves_whitespace(value: str) -> None:
+    result = TeamDescription.from_primitive(value)
+
+    assert is_ok(result)
+    description = result.unwrap()
+    assert description.to_primitive() == value
+    assert str(description) == value
+
+
+@pytest.mark.parametrize("value", ["", "x" * TeamDescription.MAX_LENGTH])
+def test_description_accepts_length_boundaries(value: str) -> None:
+    assert TeamDescription(_value=value).to_primitive() == value
+    assert TeamDescription.from_primitive(value).unwrap().to_primitive() == value
+
+
+def test_description_rejects_more_than_maximum_length() -> None:
+    value = "x" * (TeamDescription.MAX_LENGTH + 1)
+
+    with pytest.raises(ValueError, match="must not exceed 2000 characters"):
+        TeamDescription(_value=value)
+
+    result = TeamDescription.from_primitive(value)
+    assert is_err(result)
+    assert isinstance(result.error, ValueError)
+
+
+@pytest.mark.parametrize("value", [None, 123])
+def test_description_rejects_non_string_values(value: object) -> None:
+    with pytest.raises(TypeError, match="must be a string"):
+        TeamDescription(_value=value)  # type: ignore[arg-type]
+
+    result = TeamDescription.from_primitive(value)  # type: ignore[arg-type]
+    assert is_err(result)
+    assert isinstance(result.error, TypeError)
+
+
+def test_description_is_immutable() -> None:
+    description = TeamDescription("notes")
+
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        description._value = "changed"  # type: ignore[misc]
