+"""Integration checks for the team description schema migration."""
+
+import os
+import sqlite3
+import subprocess
+import sys
+from contextlib import closing
+from pathlib import Path
+
+_PREVIOUS_HEAD = "7d5f0d6a2b31"
+_MIGRATION_HEAD = "202610021430"
+
+
+def _run_alembic(database: Path, *arguments: str) -> None:
+    root = Path(__file__).resolve().parents[2]
+    env = os.environ.copy()
+    env["DATABASE_URL"] = f"sqlite+aiosqlite:///{database}"
+    env["PYTHONPATH"] = str(root / "src")
+    result = subprocess.run(
+        [sys.executable, "-m", "alembic", *arguments],
+        cwd=root,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_migration_preserves_old_teams_and_supports_round_trip(
+    tmp_path: Path,
+) -> None:
+    """Existing rows default to empty and remain intact through downgrade/up."""
+    database = tmp_path / "migration.db"
+    _run_alembic(database, "upgrade", _PREVIOUS_HEAD)
+    with closing(sqlite3.connect(database)) as connection:
+        connection.execute(
+            "INSERT INTO teams (id, name, version) VALUES (?, ?, ?)",
+            ("01ARZ3NDEKTSV4RRFFQ69G5FAV", "Legacy team", 3),
+        )
+        connection.commit()
+
+    _run_alembic(database, "upgrade", _MIGRATION_HEAD)
+    with closing(sqlite3.connect(database)) as connection:
+        row = connection.execute(
+            "SELECT name, version, description FROM teams WHERE id = ?",
+            ("01ARZ3NDEKTSV4RRFFQ69G5FAV",),
+        ).fetchone()
+    assert row == ("Legacy team", 3, "")
+
+    _run_alembic(database, "downgrade", "-1")
+    with closing(sqlite3.connect(database)) as connection:
+        columns = {row[1] for row in connection.execute("PRAGMA table_info(teams)")}
+        row = connection.execute(
+            "SELECT name, version FROM teams WHERE id = ?",
+            ("01ARZ3NDEKTSV4RRFFQ69G5FAV",),
+        ).fetchone()
+    assert "description" not in columns
+    assert row == ("Legacy team", 3)
+
+    _run_alembic(database, "upgrade", _MIGRATION_HEAD)
+    _run_alembic(database, "check")
+
+
+def test_migration_builds_clean_database(tmp_path: Path) -> None:
+    """A fresh database upgrades directly to the current metadata."""
+    database = tmp_path / "clean.db"
+    _run_alembic(database, "upgrade", "head")
+    _run_alembic(database, "check")
