+"""Tests for the teams API router."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from fastapi.routing import APIRoute
+from flow_res import Ok
+from pydantic import ValidationError
+
+from app.presentation.api.routers import teams
+from app.usecases.teams.get_team import GetTeamResult
+from app.usecases.teams.update_team_description import UpdateTeamDescriptionResult
+
+
+def test_description_route_is_registered_as_put() -> None:
+    """The router exposes the requested PUT path."""
+    assert any(
+        isinstance(route, APIRoute)
+        and route.path == "/teams/{team_id}/description"
+        and "PUT" in route.methods
+        for route in teams.router.routes
+    )
+
+
+@pytest.mark.anyio
+async def test_get_team_includes_description() -> None:
+    """The team response exposes the description returned by the query."""
+    mediator = MagicMock()
+    mediator.send_async = AsyncMock(
+        return_value=Ok(
+            GetTeamResult(
+                id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+                name="Team",
+                description="  exact\n text ",
+                version=2,
+            )
+        )
+    )
+
+    response = await teams.get_team("01ARZ3NDEKTSV4RRFFQ69G5FAV", mediator)
+
+    assert response.description == "  exact\n text "
+
+
+@pytest.mark.anyio
+async def test_put_team_description_dispatches_and_returns_update_result() -> None:
+    """The route forwards exact content and returns the update ID."""
+    mediator = MagicMock()
+    mediator.send_async = AsyncMock(
+        return_value=Ok(UpdateTeamDescriptionResult(id="01ARZ3NDEKTSV4RRFFQ69G5FAV"))
+    )
+    request = teams.UpdateTeamDescriptionRequest(description="  first\nsecond  ")
+
+    response = await teams.update_team_description(
+        "01ARZ3NDEKTSV4RRFFQ69G5FAV", request, mediator
+    )
+
+    assert response.id == "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+    command = mediator.send_async.await_args.args[0]
+    assert command.team_id == "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+    assert command.description == "  first\nsecond  "
+
+
+def test_description_request_requires_string_and_enforces_maximum() -> None:
+    """The body requires description and accepts at most 2000 characters."""
+    with pytest.raises(ValidationError):
+        teams.UpdateTeamDescriptionRequest.model_validate({})
+
+    with pytest.raises(ValidationError):
+        teams.UpdateTeamDescriptionRequest.model_validate({"description": "x" * 2001})
+
+    assert (
+        teams.UpdateTeamDescriptionRequest.model_validate(
+            {"description": ""}
+        ).description
+        == ""
+    )
