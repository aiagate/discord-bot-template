+"""Tests for UpdateTeamDescription use case."""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import TeamDescription, TeamName
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.teams.get_team import GetTeamHandler, GetTeamQuery
+from app.usecases.teams.update_team_description import (
+    UpdateTeamDescriptionCommand,
+    UpdateTeamDescriptionHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_description_update_persists_exact_value_across_unit_of_works(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Description survives a fresh unit of work without normalization."""
+    team = Team.form(name=TeamName("Team"))
+    async with uow:
+        repo = uow.GetRepository(Team)
+        add_result = await repo.add(team)
+        assert is_ok(add_result)
+        assert is_ok(await uow.commit())
+
+    description = "  first line\nsecond line \n"
+    handler = UpdateTeamDescriptionHandler(uow)
+    result = await handler.handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(), description=description
+        )
+    )
+
+    assert is_ok(result)
+    assert result.value.id == team.id.to_primitive()
+    fresh_uow = SQLAlchemyUnitOfWork(session_factory)
+    read_result = await GetTeamHandler(fresh_uow).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(read_result)
+    assert read_result.value.description == description
+
+
+@pytest.mark.anyio
+async def test_description_update_allows_empty_string(uow: IUnitOfWork) -> None:
+    """An empty string clears the current description."""
+    team = Team.form(name=TeamName("Team"))
+    async with uow:
+        repo = uow.GetRepository(Team)
+        assert is_ok(await repo.add(team))
+        assert is_ok(await uow.commit())
+
+    result = await UpdateTeamDescriptionHandler(uow).handle(
+        UpdateTeamDescriptionCommand(team_id=team.id.to_primitive(), description="")
+    )
+
+    assert is_ok(result)
+    read_result = await GetTeamHandler(uow).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(read_result)
+    assert read_result.value.description == ""
+
+
+@pytest.mark.anyio
+async def test_invalid_description_does_not_mutate_existing_team(
+    uow: IUnitOfWork,
+) -> None:
+    """Overlong input fails validation before a write is attempted."""
+    team = Team.form(name=TeamName("Team"))
+    async with uow:
+        repo = uow.GetRepository(Team)
+        assert is_ok(await repo.add(team))
+        assert is_ok(await uow.commit())
+
+    result = await UpdateTeamDescriptionHandler(uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(),
+            description="x" * (TeamDescription.MAX_LENGTH + 1),
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    read_result = await GetTeamHandler(uow).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(read_result)
+    assert read_result.value.description == ""
+
+
+@pytest.mark.anyio
+async def test_unknown_team_returns_not_found_without_creating_team(
+    uow: IUnitOfWork,
+) -> None:
+    """The update does not create a team when the requested ID is unknown."""
+    result = await UpdateTeamDescriptionHandler(uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id="01ARZ3NDEKTSV4RRFFQ69G5FAV", description="description"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_save_failure_does_not_commit_description() -> None:
+    """A repository failure is returned and the handler never commits."""
+    team = Team.form(name=TeamName("Team"))
+    mock_repo = MagicMock()
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(team))
+    mock_repo.update = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Database write failed",
+            )
+        )
+    )
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock()
+
+    result = await UpdateTeamDescriptionHandler(mock_uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(), description="new description"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.UNEXPECTED
+    mock_uow.commit.assert_not_awaited()
+
+
+@pytest.mark.anyio
+async def test_commit_failure_rolls_back_description(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A commit error leaves the durable value unchanged."""
+    team = Team.form(name=TeamName("Team"))
+    async with uow:
+        repo = uow.GetRepository(Team)
+        assert is_ok(await repo.add(team))
+        assert is_ok(await uow.commit())
+
+    monkeypatch.setattr(
+        uow,
+        "commit",
+        AsyncMock(
+            return_value=Err(
+                RepositoryError(
+                    type=RepositoryErrorType.UNEXPECTED,
+                    message="Transaction commit failed",
+                )
+            )
+        ),
+    )
+    result = await UpdateTeamDescriptionHandler(uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(), description="not committed"
+        )
+    )
+
+    assert is_err(result)
+    fresh_uow = SQLAlchemyUnitOfWork(session_factory)
+    read_result = await GetTeamHandler(fresh_uow).handle(
+        GetTeamQuery(id=team.id.to_primitive())
+    )
+    assert is_ok(read_result)
+    assert read_result.value.description == ""
+
+
+@pytest.mark.anyio
+async def test_commit_failure_is_returned() -> None:
+    """The handler surfaces transaction commit failures."""
+    team = Team.form(name=TeamName("Team"))
+    mock_repo = MagicMock()
+    mock_repo.get_by_id = AsyncMock(return_value=Ok(team))
+    mock_repo.update = AsyncMock(return_value=Ok(team))
+    mock_uow = MagicMock(spec=IUnitOfWork)
+    mock_uow.GetRepository.return_value = mock_repo
+    mock_uow.__aenter__ = AsyncMock(return_value=mock_uow)
+    mock_uow.__aexit__ = AsyncMock(return_value=None)
+    mock_uow.commit = AsyncMock(
+        return_value=Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="Transaction commit failed",
+            )
+        )
+    )
+
+    result = await UpdateTeamDescriptionHandler(mock_uow).handle(
+        UpdateTeamDescriptionCommand(
+            team_id=team.id.to_primitive(), description="new description"
+        )
+    )
+
+    assert is_err(result)
+    assert "Transaction commit failed" in result.error.message
