@@ -0,0 +1,44 @@
+"""TeamDescription value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class TeamDescription:
+    """An exact, optionally empty team description of at most 2000 characters."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 2000
+
+    def __post_init__(self) -> None:
+        """Validate the description without normalizing whitespace."""
+        if not isinstance(self._value, str):  # type: ignore[reportUnnecessaryIsInstance]
+            raise TypeError("Team description must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(
+                f"Team description must not exceed {self.MAX_LENGTH} characters."
+            )
+
+    def to_primitive(self) -> str:
+        """Return the exact string value for persistence and presentation."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["TeamDescription", Exception]:
+        """Validate a string and return it as a value object."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the exact string value."""
+        return self.to_primitive()
+
+    def __repr__(self) -> str:
+        """Return a developer-friendly representation."""
+        return f"TeamDescription({self.to_primitive()!r})"
diff --git a/src/app/usecases/teams/update_team_description.py b/src/app/usecases/teams/update_team_description.py
new file mode 100644
index 0000000..a937910
--- /dev/null
+++ b/src/app/usecases/teams/update_team_description.py
@@ -0,0 +1,78 @@
+"""Update a team's description use case."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, combine_all, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.team import Team
+from app.domain.value_objects import TeamDescription, TeamId
+from app.usecases.result import ErrorType, UseCaseError, UseCaseResultError
+
+
+@dataclass(frozen=True)
+class UpdateTeamDescriptionResult:
+    """Identifier of the updated team."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class UpdateTeamDescriptionCommand(
+    Request[Result[UpdateTeamDescriptionResult, UseCaseResultError]]
+):
+    """Command to replace an existing team's description."""
+
+    team_id: str
+    description: str
+
+
+class UpdateTeamDescriptionHandler(
+    RequestHandler[
+        UpdateTeamDescriptionCommand,
+        Result[UpdateTeamDescriptionResult, UseCaseResultError],
+    ]
+):
+    """Validate, replace, and persist an existing team's description."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: UpdateTeamDescriptionCommand
+    ) -> Result[UpdateTeamDescriptionResult, UseCaseResultError]:
+        """Update the team by ID, keeping validation and writes in one flow."""
+        team_id_result = TeamId.from_primitive(request.team_id)
+        description_result = TeamDescription.from_primitive(request.description)
+        combined_result = combine_all((team_id_result, description_result)).map_err(
+            lambda error: UseCaseError(
+                type=ErrorType.VALIDATION_ERROR,
+                message=", ".join(str(exc) for exc in error.exceptions),
+            )
+        )
+        if is_err(combined_result):
+            return Err(combined_result.error)
+
+        team_id, description = combined_result.unwrap()
+        async with self._uow:
+            team_repo = self._uow.GetRepository(Team, TeamId)
+            team_result = await team_repo.get_by_id(team_id)
+            if is_err(team_result):
+                return Err(team_result.error)
+
+            team = team_result.unwrap()
+            team.change_description(description)
+            update_result = await team_repo.update(team)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+            return Ok(
+                UpdateTeamDescriptionResult(id=update_result.unwrap().id.to_primitive())
+            )
