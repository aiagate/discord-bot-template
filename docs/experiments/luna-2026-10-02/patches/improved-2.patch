+"""Tests for UserBio value object validation and preservation."""
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import UserBio
+
+
+@pytest.mark.parametrize("value", ["", "  hello\nworld  ", "x" * 500])
+def test_user_bio_preserves_valid_values(value: str) -> None:
+    """Empty, whitespace-rich, and maximum length bios are retained verbatim."""
+    result = UserBio.from_primitive(value)
+
+    assert is_ok(result)
+    assert result.unwrap().to_primitive() == value
+
+
+def test_user_bio_rejects_values_over_maximum_length() -> None:
+    """A bio longer than 500 characters is invalid."""
+    result = UserBio.from_primitive("x" * 501)
+
+    assert is_err(result)
+    assert "must not exceed 500" in str(result.error)
+
+
+@pytest.mark.parametrize("value", [None, 123])
+def test_user_bio_rejects_non_strings(value: object) -> None:
+    """The value object rejects values that are not strings."""
+    with pytest.raises(TypeError, match="must be a string"):
+        UserBio(value)  # type: ignore[arg-type]
+
+    result = UserBio.from_primitive(value)  # type: ignore[arg-type]
+    assert is_err(result)
+    assert isinstance(result.error, TypeError)
