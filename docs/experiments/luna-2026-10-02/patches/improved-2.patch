@@ -0,0 +1,104 @@
+"""Tests for migrating user biographies on an existing users table."""
+
+import importlib.util
+from io import StringIO
+from pathlib import Path
+from typing import Any
+
+import pytest
+import sqlalchemy as sa
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy.ext.asyncio import create_async_engine
+
+_MIGRATION_PATH = (
+    Path(__file__).parents[2] / "alembic" / "versions" / "202610021430_add_user_bio.py"
+)
+
+
+def _load_migration() -> Any:
+    spec = importlib.util.spec_from_file_location("user_bio_migration", _MIGRATION_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("Could not load user bio migration.")
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    return migration
+
+
+def _run_operation(connection: sa.Connection, operation: str) -> None:
+    context = MigrationContext.configure(connection)
+    migration = _load_migration()
+    with Operations.context(context):
+        getattr(migration, operation)()
+
+
+@pytest.mark.anyio
+async def test_migration_backfills_old_users_and_round_trips() -> None:
+    """Old rows get an empty bio and retain their existing user attributes."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    users = sa.Table(
+        "users",
+        metadata,
+        sa.Column("id", sa.String(26), primary_key=True),
+        sa.Column("display_name", sa.String(255), nullable=False),
+        sa.Column("email", sa.String(255), nullable=False),
+    )
+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            users.insert(),
+            {
+                "id": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
+                "display_name": "Alice",
+                "email": "alice@example.com",
+            },
+        )
+        await connection.run_sync(lambda conn: _run_operation(conn, "upgrade"))
+
+        upgraded = (
+            await connection.execute(
+                sa.text("SELECT id, display_name, email, bio FROM users")
+            )
+        ).one()
+        assert tuple(upgraded) == (
+            "01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            "Alice",
+            "alice@example.com",
+            "",
+        )
+
+        await connection.run_sync(lambda conn: _run_operation(conn, "downgrade"))
+        downgraded = (
+            await connection.execute(
+                sa.select(users.c.id, users.c.display_name, users.c.email)
+            )
+        ).one()
+        assert tuple(downgraded) == (
+            "01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            "Alice",
+            "alice@example.com",
+        )
+
+        await connection.run_sync(lambda conn: _run_operation(conn, "upgrade"))
+        bio = (await connection.execute(sa.text("SELECT bio FROM users"))).scalar_one()
+
+    await engine.dispose()
+    assert bio == ""
+
+
+def test_migration_offline_sql_adds_non_null_column_with_default() -> None:
+    """Offline SQL includes the default required to backfill old rows."""
+    output = StringIO()
+    context = MigrationContext.configure(
+        url="sqlite://",
+        opts={"as_sql": True, "output_buffer": output},
+    )
+    migration = _load_migration()
+
+    with Operations.context(context):
+        migration.upgrade()
+
+    generated_sql = output.getvalue()
+    assert "ADD COLUMN bio VARCHAR(500) DEFAULT '' NOT NULL" in generated_sql
