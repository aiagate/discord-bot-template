+"""UserBio value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class UserBio:
+    """A user's biography, preserving all supplied whitespace."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 500
+
+    def __post_init__(self) -> None:
+        """Validate the biography without normalizing its content."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("User bio must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(f"User bio must not exceed {self.MAX_LENGTH} characters.")
+
+    def to_primitive(self) -> str:
+        """Return the biography as a primitive string."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["UserBio", Exception]:
+        """Create a UserBio from a primitive string."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the raw biography."""
+        return self.to_primitive()
+
+    def __repr__(self) -> str:
+        """Return a developer-friendly representation."""
+        return f"UserBio({self.to_primitive()!r})"
