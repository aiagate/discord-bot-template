+"""Tests for the FastAPI users router's profile contract."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi.routing import APIRoute
+from flow_res import Ok
+from pydantic import ValidationError
+
+from app.presentation.api.routers.users import (
+    UpdateUserProfileRequest,
+    UserResponse,
+    get_user,
+    router,
+    update_user_profile,
+)
+from app.usecases.users.get_user import GetUserResult
+from app.usecases.users.update_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileResult,
+)
+
+
+def test_profile_request_requires_both_fields() -> None:
+    """The update body must include both display name and bio."""
+    assert UpdateUserProfileRequest.model_fields["display_name"].is_required()
+    assert UpdateUserProfileRequest.model_fields["bio"].is_required()
+    with pytest.raises(ValidationError):
+        UpdateUserProfileRequest(display_name="Alice")  # type: ignore[call-arg]
+
+
+@pytest.mark.anyio
+async def test_get_user_response_includes_bio() -> None:
+    """GET /users/{id} exposes a saved bio in its response model."""
+    mediator = AsyncMock()
+    mediator.send_async.return_value = Ok(
+        GetUserResult(
+            id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            display_name="Alice",
+            email="alice@example.com",
+            bio="Hi there",
+        )
+    )
+
+    response = await get_user("01ARZ3NDEKTSV4RRFFQ69G5FAV", mediator)
+
+    assert isinstance(response, UserResponse)
+    assert response.bio == "Hi there"
+
+
+@pytest.mark.anyio
+async def test_put_user_profile_returns_updated_user_id() -> None:
+    """PUT /users/{id}/profile follows update response convention."""
+    user_id = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+    mediator = AsyncMock()
+    mediator.send_async.return_value = Ok(UpdateUserProfileResult(id=user_id))
+    request = UpdateUserProfileRequest(display_name="Alicia", bio="  Hi\nthere  ")
+
+    response = await update_user_profile(user_id, request, mediator)
+
+    assert response.id == user_id
+    sent_command = mediator.send_async.await_args.args[0]
+    assert sent_command == UpdateUserProfileCommand(
+        user_id=user_id,
+        display_name="Alicia",
+        bio="  Hi\nthere  ",
+    )
+    route = next(
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute) and route.path == "/users/{user_id}/profile"
+    )
+    assert "PUT" in route.methods
diff --git a/tests/usecases/users/test_update_profile.py b/tests/usecases/users/test_update_profile.py
new file mode 100644
index 0000000..68ee2e4
--- /dev/null
+++ b/tests/usecases/users/test_update_profile.py
@@ -0,0 +1,191 @@
+"""Tests for atomic user profile updates."""
+
+import pytest
+from flow_res import Err, Result, is_err, is_ok
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import DisplayName, Email
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.users.get_user import GetUserHandler, GetUserQuery
+from app.usecases.users.update_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileHandler,
+)
+
+
+async def _create_user(uow: IUnitOfWork) -> User:
+    user = User.register(DisplayName("Alice"), Email("alice@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        saved = await repo.add(user)
+        assert is_ok(saved)
+        assert is_ok(await uow.commit())
+    return saved.unwrap()
+
+
+@pytest.mark.anyio
+async def test_update_profile_persists_both_fields_in_a_separate_uow(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A new Unit of Work can read the saved profile after the update."""
+    saved_user = await _create_user(uow)
+    handler = UpdateUserProfileHandler(uow)
+    result = await handler.handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(),
+            display_name="Alicia",
+            bio="  hello\nworld  ",
+        )
+    )
+
+    assert is_ok(result)
+    assert result.value.id == saved_user.id.to_primitive()
+
+    # A distinct Unit of Work and Session prove that both fields were persisted.
+    reader = SQLAlchemyUnitOfWork(session_factory)
+    loaded = await GetUserHandler(reader).handle(
+        GetUserQuery(user_id=saved_user.id.to_primitive())
+    )
+
+    assert is_ok(loaded)
+    assert loaded.value.id == saved_user.id.to_primitive()
+    assert loaded.value.display_name == "Alicia"
+    assert loaded.value.bio == "  hello\nworld  "
+    assert loaded.value.email == "alice@example.com"
+
+
+@pytest.mark.anyio
+async def test_update_profile_rejects_invalid_input_without_changing_user(
+    uow: IUnitOfWork,
+) -> None:
+    """Invalid fields fail validation before a partial change can be saved."""
+    saved_user = await _create_user(uow)
+    handler = UpdateUserProfileHandler(uow)
+
+    for display_name, bio in [("", "new bio"), ("New Name", "x" * 501)]:
+        result = await handler.handle(
+            UpdateUserProfileCommand(
+                user_id=saved_user.id.to_primitive(),
+                display_name=display_name,
+                bio=bio,
+            )
+        )
+        assert is_err(result)
+        assert result.error.type == ErrorType.VALIDATION_ERROR
+
+    loaded = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=saved_user.id.to_primitive())
+    )
+    assert is_ok(loaded)
+    assert loaded.value.display_name == "Alice"
+    assert loaded.value.bio == ""
+
+
+@pytest.mark.anyio
+async def test_update_profile_unknown_user_does_not_create_user(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """An unknown valid ID returns the existing not-found contract."""
+    handler = UpdateUserProfileHandler(uow)
+    result = await handler.handle(
+        UpdateUserProfileCommand(
+            user_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            display_name="Alice",
+            bio="Bio",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+    async with session_factory() as session:
+        user_count = (
+            await session.execute(text("SELECT COUNT(*) FROM users"))
+        ).scalar_one()
+    assert user_count == 0
+
+
+@pytest.mark.anyio
+async def test_update_profile_write_failure_keeps_existing_values(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A database write failure rolls back the full profile update."""
+    saved_user = await _create_user(uow)
+
+    async with session_factory() as session:
+        await session.execute(
+            text(
+                "CREATE TRIGGER reject_user_profile BEFORE UPDATE ON users "
+                "BEGIN SELECT RAISE(ABORT, 'profile write rejected'); END"
+            )
+        )
+        await session.commit()
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(),
+            display_name="Alicia",
+            bio="partial profile should not persist",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.ALREADY_EXISTS
+
+    async with session_factory() as session:
+        row = (
+            await session.execute(
+                text("SELECT display_name, bio FROM users WHERE id = :user_id"),
+                {"user_id": saved_user.id.to_primitive()},
+            )
+        ).one()
+        await session.execute(text("DROP TRIGGER reject_user_profile"))
+        await session.commit()
+
+    assert tuple(row) == ("Alice", "")
+
+
+@pytest.mark.anyio
+async def test_update_profile_commit_failure_rolls_back_both_fields(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A failed commit leaves the existing profile intact."""
+    saved_user = await _create_user(uow)
+
+    class FailedCommitUnitOfWork(SQLAlchemyUnitOfWork):
+        async def commit(self) -> Result[None, RepositoryError]:
+            return Err(
+                RepositoryError(
+                    type=RepositoryErrorType.UNEXPECTED,
+                    message="commit failed",
+                )
+            )
+
+    failing_uow = FailedCommitUnitOfWork(session_factory)
+
+    result = await UpdateUserProfileHandler(failing_uow).handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(),
+            display_name="Alicia",
+            bio="not committed",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.message == "commit failed"
+
+    loaded = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=saved_user.id.to_primitive())
+    )
+    assert is_ok(loaded)
+    assert loaded.value.display_name == "Alice"
+    assert loaded.value.bio == ""
