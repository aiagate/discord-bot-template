@@ -0,0 +1,96 @@
+"""Tests for the user bio migration."""
+
+import importlib.util
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import pytest
+import sqlalchemy as sa
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy.ext.asyncio import create_async_engine
+
+_MIGRATION_PATH = (
+    Path(__file__).parents[2]
+    / "alembic"
+    / "versions"
+    / "202610021500_9c2fdc3add17_add_bio_to_users.py"
+)
+
+
+def _load_migration() -> Any:
+    spec = importlib.util.spec_from_file_location("user_bio_migration", _MIGRATION_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("Could not load user bio migration.")
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    return migration
+
+
+def _users_table(metadata: sa.MetaData) -> sa.Table:
+    return sa.Table(
+        "users",
+        metadata,
+        sa.Column("id", sa.String(26), primary_key=True),
+        sa.Column("display_name", sa.String(255), nullable=False),
+        sa.Column("email", sa.String(255), nullable=False),
+        sa.Column("version", sa.Integer(), nullable=False),
+        sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
+        sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
+    )
+
+
+@pytest.mark.anyio
+async def test_migration_backfills_existing_users_and_can_roll_back() -> None:
+    """Upgrade preserves legacy user fields and fills bio with an empty string."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    users = _users_table(metadata)
+    migration = _load_migration()
+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            users.insert().values(
+                id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+                display_name="Existing",
+                email="existing@example.com",
+                version=3,
+                created_at=datetime(2026, 9, 1, 9, 0, tzinfo=UTC),
+                updated_at=datetime(2026, 9, 2, 10, 0, tzinfo=UTC),
+            )
+        )
+
+        def run_upgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.upgrade()
+
+        def run_downgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.downgrade()
+
+        await connection.run_sync(run_upgrade)
+
+        # Reflect inside the sync connection to inspect both old and new fields.
+        def read_upgraded_row(sync_connection: sa.Connection) -> dict[str, object]:
+            reflected = sa.Table("users", sa.MetaData(), autoload_with=sync_connection)
+            return dict(sync_connection.execute(sa.select(reflected)).mappings().one())
+
+        row = await connection.run_sync(read_upgraded_row)
+        assert row["bio"] == ""
+        assert row["display_name"] == "Existing"
+        assert row["email"] == "existing@example.com"
+        assert row["version"] == 3
+        await connection.run_sync(run_downgrade)
+        remaining_columns = await connection.run_sync(
+            lambda sync_connection: {
+                column["name"]
+                for column in sa.inspect(sync_connection).get_columns("users")
+            }
+        )
+
+    await engine.dispose()
+    assert "bio" not in remaining_columns
