+"""UserBio value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class UserBio:
+    """An immutable user bio that preserves its input verbatim."""
+
+    _value: str
+
+    MIN_LENGTH: ClassVar[int] = 0
+    MAX_LENGTH: ClassVar[int] = 500
+
+    def __post_init__(self) -> None:
+        """Validate the bio's type and maximum length without normalizing it."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("User bio must be a string.")
+        if len(self._value) < self.MIN_LENGTH:
+            raise ValueError("User bio cannot be shorter than 0 characters.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(f"User bio must not exceed {self.MAX_LENGTH} characters.")
+
+    def to_primitive(self) -> str:
+        """Return the original bio string."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["UserBio", Exception]:
+        """Create a UserBio from its primitive representation."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the primitive bio string."""
+        return self.to_primitive()
+
+    def __repr__(self) -> str:
+        """Return a developer-friendly representation."""
+        return f"UserBio({self.to_primitive()!r})"
