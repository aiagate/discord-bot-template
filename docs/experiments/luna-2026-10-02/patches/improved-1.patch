+"""Tests for the users profile HTTP contract."""
+
+from typing import Any, cast
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi import HTTPException
+from fastapi.routing import APIRoute
+from flow_res import Err, Ok
+from pydantic import ValidationError
+
+from app.application.mediator import ApplicationMediator
+from app.presentation.api.routers.users import (
+    UpdateUserProfileRequest,
+    UpdateUserProfileResponse,
+    UserResponse,
+    router,
+    update_user_profile,
+)
+from app.usecases.result import ErrorType, UseCaseError
+from app.usecases.users.update_user_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileResult,
+)
+
+
+def test_profile_request_requires_both_fields_and_accepts_empty_bio() -> None:
+    """The PUT payload requires both fields, while permitting an empty bio."""
+    request = UpdateUserProfileRequest.model_validate(
+        {"display_name": "Alice", "bio": ""}
+    )
+    assert request.bio == ""
+
+    with pytest.raises(ValidationError):
+        UpdateUserProfileRequest.model_validate({"display_name": "Alice"})
+
+
+def test_profile_route_is_put_and_get_response_exposes_bio() -> None:
+    """The profile update path uses PUT and user reads include the bio field."""
+    route = next(
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute) and route.path == "/users/{user_id}/profile"
+    )
+    assert route.methods == {"PUT"}
+    assert "bio" in UserResponse.model_fields
+
+
+@pytest.mark.anyio
+async def test_profile_route_sends_both_values_and_returns_update_result() -> None:
+    """The route dispatches the requested profile and returns the existing ID."""
+    mediator = _Mediator(Ok(UpdateUserProfileResult(id="user-id")))
+
+    response = await update_user_profile(
+        "user-id",
+        UpdateUserProfileRequest(
+            display_name="Alice Example", bio="  line one\nline two  "
+        ),
+        cast(ApplicationMediator, mediator),
+    )
+
+    assert isinstance(response, UpdateUserProfileResponse)
+    assert response.id == "user-id"
+    call = mediator.send_async.await_args
+    assert call is not None
+    command = call.args[0]
+    assert isinstance(command, UpdateUserProfileCommand)
+    assert command == UpdateUserProfileCommand(
+        user_id="user-id",
+        display_name="Alice Example",
+        bio="  line one\nline two  ",
+    )
+
+
+@pytest.mark.anyio
+async def test_profile_route_maps_usecase_errors_to_http_errors() -> None:
+    """The route preserves the API's existing HTTP error mapping behavior."""
+    mediator = _Mediator(
+        Err(UseCaseError(type=ErrorType.VALIDATION_ERROR, message="invalid profile"))
+    )
+
+    with pytest.raises(HTTPException) as error:
+        await update_user_profile(
+            "user-id",
+            UpdateUserProfileRequest(display_name="Alice", bio="bio"),
+            cast(ApplicationMediator, mediator),
+        )
+
+    assert error.value.status_code == 400
+    assert error.value.detail == "invalid profile"
+
+
+class _Mediator:
+    def __init__(self, result: Any) -> None:
+        self.send_async = AsyncMock(return_value=result)
