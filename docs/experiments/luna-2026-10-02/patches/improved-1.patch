+"""Tests for UpdateUserProfile use case."""
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from flow_res import Err, Ok, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import DisplayName, Email, UserBio, UserId
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.users.update_user_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_update_profile_persists_both_fields_for_a_later_uow(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """A profile survives repository reload in a separate UoW scope."""
+    user = User.register(DisplayName("Before"), Email("profile@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        created = await repo.add(user)
+        assert is_ok(created)
+        saved_user = created.value
+        assert is_ok(await uow.commit())
+
+    handler = UpdateUserProfileHandler(uow)
+    result = await handler.handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(),
+            display_name="After",
+            bio="  hello\nworld  ",
+        )
+    )
+
+    assert is_ok(result)
+    assert result.value.id == saved_user.id.to_primitive()
+    read_uow = SQLAlchemyUnitOfWork(session_factory)
+    async with read_uow:
+        repo = read_uow.GetRepository(User, UserId)
+        loaded = await repo.get_by_id(saved_user.id)
+        assert is_ok(loaded)
+        assert loaded.value.display_name == DisplayName("After")
+        assert loaded.value.bio == UserBio("  hello\nworld  ")
+        assert loaded.value.email == Email("profile@example.com")
+
+
+@pytest.mark.anyio
+async def test_update_profile_allows_empty_bio(uow: IUnitOfWork) -> None:
+    """An empty bio is a valid profile value."""
+    user = User.register(DisplayName("Before"), Email("empty@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        created = await repo.add(user)
+        assert is_ok(created)
+        saved_user = created.value
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(),
+            display_name="After",
+            bio="",
+        )
+    )
+
+    assert is_ok(result)
+    async with uow:
+        repo = uow.GetRepository(User, UserId)
+        loaded = await repo.get_by_id(saved_user.id)
+        assert is_ok(loaded)
+        assert loaded.value.bio == UserBio("")
+
+
+@pytest.mark.anyio
+async def test_update_profile_invalid_input_does_not_change_any_field(
+    uow: IUnitOfWork,
+) -> None:
+    """Both inputs are validated before the existing user is modified."""
+    user = User.register(DisplayName("Before"), Email("invalid@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        created = await repo.add(user)
+        assert is_ok(created)
+        saved_user = created.value
+        assert is_ok(await uow.commit())
+
+    command = UpdateUserProfileCommand(
+        user_id=saved_user.id.to_primitive(),
+        display_name="After",
+        bio="x" * 501,
+    )
+    result = await UpdateUserProfileHandler(uow).handle(command)
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    async with uow:
+        repo = uow.GetRepository(User, UserId)
+        loaded = await repo.get_by_id(saved_user.id)
+        assert is_ok(loaded)
+        assert loaded.value.display_name == DisplayName("Before")
+        assert loaded.value.bio == UserBio("")
+
+
+@pytest.mark.anyio
+async def test_update_profile_rejects_invalid_display_name(uow: IUnitOfWork) -> None:
+    """The existing display-name validation remains in force."""
+    user = User.register(DisplayName("Before"), Email("name@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        created = await repo.add(user)
+        assert is_ok(created)
+        saved_user = created.value
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=saved_user.id.to_primitive(), display_name="  After", bio="valid"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    async with uow:
+        repo = uow.GetRepository(User, UserId)
+        loaded = await repo.get_by_id(saved_user.id)
+        assert is_ok(loaded)
+        assert loaded.value.display_name == DisplayName("Before")
+        assert loaded.value.bio == UserBio("")
+
+
+@pytest.mark.anyio
+async def test_update_profile_user_not_found_returns_repository_error(
+    uow: IUnitOfWork,
+) -> None:
+    """An unknown valid ID returns NOT_FOUND rather than creating a user."""
+    command = UpdateUserProfileCommand(
+        user_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+        display_name="After",
+        bio="A bio",
+    )
+
+    result = await UpdateUserProfileHandler(uow).handle(command)
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_commit_failure_rolls_back_both_profile_fields(uow: IUnitOfWork) -> None:
+    """A failed commit leaves the previously saved profile intact."""
+    user = User.register(DisplayName("Before"), Email("rollback-profile@example.com"))
+    async with uow:
+        repo = uow.GetRepository(User)
+        created = await repo.add(user)
+        assert is_ok(created)
+        saved_user = created.value
+        assert is_ok(await uow.commit())
+
+    commit_error = RepositoryError(
+        type=RepositoryErrorType.UNEXPECTED,
+        message="simulated commit failure",
+    )
+    with patch.object(uow, "commit", new=AsyncMock(return_value=Err(commit_error))):
+        result = await UpdateUserProfileHandler(uow).handle(
+            UpdateUserProfileCommand(
+                user_id=saved_user.id.to_primitive(),
+                display_name="After",
+                bio="not committed",
+            )
+        )
+
+    assert is_err(result)
+    assert result.error is commit_error
+    async with uow:
+        repo = uow.GetRepository(User, UserId)
+        loaded = await repo.get_by_id(saved_user.id)
+        assert is_ok(loaded)
+        assert loaded.value.display_name == DisplayName("Before")
+        assert loaded.value.bio == UserBio("")
+
+
+@pytest.mark.anyio
+async def test_repository_update_failure_does_not_commit() -> None:
+    """A repository save failure is returned and the UoW is not committed."""
+    user = User.register(DisplayName("Before"), Email("failure@example.com"))
+    repository_error = RepositoryError(
+        type=RepositoryErrorType.UNEXPECTED,
+        message="simulated save failure",
+    )
+    repo = MagicMock()
+    repo.get_by_id = AsyncMock(return_value=Ok(user))
+    repo.update = AsyncMock(return_value=Err(repository_error))
+    uow = MagicMock(spec=IUnitOfWork)
+    uow.GetRepository.return_value = repo
+    uow.__aenter__ = AsyncMock(return_value=uow)
+    uow.__aexit__ = AsyncMock(return_value=None)
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(), display_name="After", bio="new bio"
+        )
+    )
+
+    assert is_err(result)
+    assert result.error is repository_error
+    uow.commit.assert_not_awaited()
