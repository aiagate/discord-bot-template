+from pydantic import ValidationError
+
+from app.presentation.api.routers.users import (
+    UpdateUserProfileRequest,
+    get_user,
+    router,
+    update_user_profile,
+)
+from app.usecases.users.get_user import GetUserResult
+from app.usecases.users.update_user_profile import UpdateUserProfileResult
+
+
+@pytest.mark.anyio
+async def test_update_profile_and_get_user_expose_bio() -> None:
+    """The API requires and forwards both profile fields and returns bio on GET."""
+    mediator = AsyncMock()
+    user_id = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+    mediator.send_async.side_effect = [
+        Ok(UpdateUserProfileResult(id=user_id)),
+        Ok(
+            GetUserResult(
+                id=user_id,
+                display_name="Updated",
+                email="user@example.com",
+                bio="  two lines\nsecond  ",
+            )
+        ),
+    ]
+    updated = await update_user_profile(
+        user_id,
+        UpdateUserProfileRequest(display_name="Updated", bio="  two lines\nsecond  "),
+        mediator,
+    )
+    fetched = await get_user(user_id, mediator)
+
+    assert updated.id == user_id
+    sent_command = mediator.send_async.call_args_list[0].args[0]
+    assert sent_command.user_id == user_id
+    assert sent_command.display_name == "Updated"
+    assert sent_command.bio == "  two lines\nsecond  "
+    assert fetched.model_dump() == {
+        "id": user_id,
+        "display_name": "Updated",
+        "email": "user@example.com",
+        "bio": "  two lines\nsecond  ",
+    }
+
+
+def test_profile_update_requires_both_fields() -> None:
+    """Missing either profile property is rejected by request validation."""
+    for values in ({"display_name": "Updated"}, {"bio": "bio"}):
+        with pytest.raises(ValidationError):
+            UpdateUserProfileRequest.model_validate(values)
+
+
+def test_profile_route_is_registered_with_both_fields_required() -> None:
+    """OpenAPI exposes the requested PUT path and required profile body."""
+    app = FastAPI()
+    app.include_router(router)
+
+    operation = app.openapi()["paths"]["/users/{user_id}/profile"]["put"]
+    request_schema = operation["requestBody"]["content"]["application/json"]["schema"]
+    schema_name = request_schema["$ref"].rsplit("/", 1)[-1]
+
+    assert operation["requestBody"]["required"] is True
+    assert app.openapi()["components"]["schemas"][schema_name]["required"] == [
+        "display_name",
+        "bio",
+    ]
