index 0000000..fabcedf
--- /dev/null
+++ b/src/app/domain/value_objects/bio.py
@@ -0,0 +1,41 @@
+"""Bio value object with length validation."""
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class Bio:
+    """A profile bio that preserves its exact input text."""
+
+    _value: str
+
+    MIN_LENGTH: ClassVar[int] = 0
+    MAX_LENGTH: ClassVar[int] = 500
+
+    def __post_init__(self) -> None:
+        """Validate type and length without normalizing whitespace."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("Bio must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(f"Bio must not exceed {self.MAX_LENGTH} characters.")
+
+    def to_primitive(self) -> str:
+        """Return the exact bio text."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result["Bio", Exception]:
+        """Create a Bio from a primitive string, returning validation errors."""
+        try:
+            return Ok(cls(_value=value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
+
+    def __str__(self) -> str:
+        """Return the bio text."""
+        return self.to_primitive()
