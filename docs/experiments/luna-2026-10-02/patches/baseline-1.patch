index 0000000..cb13e5b
--- /dev/null
+++ b/src/app/usecases/users/update_user_profile.py
@@ -0,0 +1,85 @@
+"""Update an existing user's profile use case."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, combine_all, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.value_objects import Bio, DisplayName, UserId
+from app.usecases.result import ErrorType, UseCaseError, UseCaseResultError
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileResult:
+    """Result of a profile update."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileCommand(
+    Request[Result[UpdateUserProfileResult, UseCaseResultError]]
+):
+    """Command to replace an existing user's display name and bio."""
+
+    user_id: str
+    display_name: str
+    bio: str
+
+
+class UpdateUserProfileHandler(
+    RequestHandler[
+        UpdateUserProfileCommand,
+        Result[UpdateUserProfileResult, UseCaseResultError],
+    ]
+):
+    """Handler for replacing a user's profile atomically."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: UpdateUserProfileCommand
+    ) -> Result[UpdateUserProfileResult, UseCaseResultError]:
+        """Validate, update, and commit both profile fields together."""
+        inputs = combine_all(
+            (
+                UserId.from_primitive(request.user_id),
+                DisplayName.from_primitive(request.display_name),
+                Bio.from_primitive(request.bio),
+            )
+        ).map_err(
+            lambda error: UseCaseError(
+                type=ErrorType.VALIDATION_ERROR,
+                message=", ".join(str(exc) for exc in error.exceptions),
+            )
+        )
+        if is_err(inputs):
+            return Err(inputs.error)
+
+        user_id, display_name, bio = inputs.unwrap()
+
+        async with self._uow:
+            user_repo = self._uow.GetRepository(User, UserId)
+            get_result = await user_repo.get_by_id(user_id)
+            if is_err(get_result):
+                return Err(get_result.error)
+
+            user = get_result.unwrap()
+            user.change_profile(display_name, bio)
+
+            update_result = await user_repo.update(user)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+            return Ok(
+                UpdateUserProfileResult(id=update_result.unwrap().id.to_primitive())
+            )
