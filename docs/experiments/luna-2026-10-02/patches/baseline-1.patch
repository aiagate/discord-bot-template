+"""Tests for replacing and persisting user profiles."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+from flow_res import Err, Result, is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.repositories import RepositoryError, RepositoryErrorType
+from app.domain.value_objects import DisplayName, Email, UserId
+from app.infrastructure.repositories.generic_repository import GenericRepository
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.users.get_user import GetUserHandler, GetUserQuery
+from app.usecases.users.update_user_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileHandler,
+)
+
+
+async def _create_user(uow: IUnitOfWork) -> User:
+    async with uow:
+        repo = uow.GetRepository(User)
+        result = await repo.add(
+            User.register(
+                display_name=DisplayName("Original"),
+                email=Email("profile@example.com"),
+            )
+        )
+        assert is_ok(result)
+        saved = result.value
+        committed = await uow.commit()
+        assert is_ok(committed)
+        return saved
+
+
+@pytest.mark.anyio
+async def test_update_user_profile_persists_for_a_new_unit_of_work(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Both values persist and can be read through a separate Unit of Work."""
+    user = await _create_user(uow)
+    handler = UpdateUserProfileHandler(uow)
+    bio = "  Hello\nworld  "
+
+    result = await handler.handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Updated",
+            bio=bio,
+        )
+    )
+
+    assert is_ok(result)
+    assert result.value.id == user.id.to_primitive()
+
+    # A fresh UoW proves this was committed rather than read from its identity map.
+    fresh_uow = SQLAlchemyUnitOfWork(session_factory)
+    fetched = await GetUserHandler(fresh_uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(fetched)
+    assert fetched.value.display_name == "Updated"
+    assert fetched.value.bio == bio
+    assert fetched.value.email == "profile@example.com"
+
+
+@pytest.mark.anyio
+async def test_new_user_starts_with_empty_bio(uow: IUnitOfWork) -> None:
+    """Existing user creation defaults the new profile field to empty."""
+    user = await _create_user(uow)
+    result = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(result)
+    assert result.value.bio == ""
+
+
+@pytest.mark.anyio
+async def test_profile_validation_does_not_partially_update_user(
+    uow: IUnitOfWork,
+) -> None:
+    """Rejecting an invalid bio leaves the previously saved display name intact."""
+    user = await _create_user(uow)
+    handler = UpdateUserProfileHandler(uow)
+
+    result = await handler.handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Changed",
+            bio="x" * 501,
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+    fetched = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(fetched)
+    assert fetched.value.display_name == "Original"
+    assert fetched.value.bio == ""
+
+
+@pytest.mark.anyio
+async def test_profile_update_unknown_user_does_not_create_a_user(
+    uow: IUnitOfWork,
+) -> None:
+    """Unknown IDs return the repository's existing not-found error."""
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id="01ARZ3NDEKTSV4RRFFQ69G5FAV",
+            display_name="Nobody",
+            bio="bio",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+
+@pytest.mark.anyio
+async def test_profile_update_propagates_save_failure_without_committing(
+    uow: IUnitOfWork,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A repository save error aborts the transaction before commit."""
+    user = await _create_user(uow)
+    commit = AsyncMock(side_effect=AssertionError("commit must not run"))
+    monkeypatch.setattr(uow, "commit", commit)
+
+    async def fail_update(
+        _repository: GenericRepository[User, UserId], _user: User
+    ) -> Result[User, RepositoryError]:
+        return Err(
+            RepositoryError(
+                type=RepositoryErrorType.UNEXPECTED,
+                message="simulated save failure",
+            )
+        )
+
+    monkeypatch.setattr(GenericRepository, "update", fail_update)
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Changed",
+            bio="bio",
+        )
+    )
+
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.UNEXPECTED
+    commit.assert_not_awaited()
+
+    monkeypatch.undo()
+    fetched = await GetUserHandler(uow).handle(
+        GetUserQuery(user_id=user.id.to_primitive())
+    )
+    assert is_ok(fetched)
+    assert fetched.value.display_name == "Original"
+    assert fetched.value.bio == ""
