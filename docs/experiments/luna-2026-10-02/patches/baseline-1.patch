+"""Tests for Bio validation and exact text preservation."""
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import Bio
+
+
+@pytest.mark.parametrize("value", ("", "  ", "line one\nline two", "x" * 500))
+def test_bio_accepts_and_preserves_valid_text(value: str) -> None:
+    result = Bio.from_primitive(value)
+
+    assert is_ok(result)
+    assert result.value.to_primitive() == value
+
+
+def test_bio_rejects_more_than_500_characters() -> None:
+    result = Bio.from_primitive("x" * 501)
+
+    assert is_err(result)
+    assert isinstance(result.error, ValueError)
+
+
+def test_bio_rejects_non_string_values() -> None:
+    with pytest.raises(TypeError, match="Bio must be a string"):
+        Bio(1)  # type: ignore[arg-type]
