new file mode 100644
index 0000000..82bd8e0
--- /dev/null
+++ b/tests/infrastructure/test_user_profile_migration.py
@@ -0,0 +1,98 @@
+"""Tests for adding bio to databases containing existing users."""
+
+import importlib.util
+from pathlib import Path
+from typing import Any
+
+import pytest
+import sqlalchemy as sa
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy.ext.asyncio import create_async_engine
+
+_MIGRATION_PATH = (
+    Path(__file__).parents[2]
+    / "alembic"
+    / "versions"
+    / "202610020900_4f6c3b2a1d90_add_bio_to_users.py"
+)
+
+
+def _load_migration() -> Any:
+    spec = importlib.util.spec_from_file_location(
+        "user_profile_migration", _MIGRATION_PATH
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError("Could not load user profile migration.")
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    return migration
+
+
+@pytest.mark.anyio
+async def test_migration_backfills_old_users_and_supports_default_bio() -> None:
+    """Old records and inserts omitting bio receive the empty-string default."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    users = sa.Table(
+        "users",
+        metadata,
+        sa.Column("id", sa.String(26), primary_key=True),
+        sa.Column("display_name", sa.String(255), nullable=False),
+        sa.Column("email", sa.String(255), nullable=False),
+        sa.Column("version", sa.Integer(), nullable=False),
+    )
+    migration = _load_migration()
+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            users.insert().values(
+                id="legacy-user",
+                display_name="Legacy",
+                email="legacy@example.com",
+                version=0,
+            )
+        )
+
+        def run_upgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.upgrade()
+
+        def run_downgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.downgrade()
+
+        await connection.run_sync(run_upgrade)
+
+        # Reflect through the synchronous connection after the migration.
+        def read_bios(sync_connection: sa.Connection) -> list[str]:
+            table = sa.Table("users", sa.MetaData(), autoload_with=sync_connection)
+            sync_connection.execute(
+                table.insert().values(
+                    id="new-user",
+                    display_name="New",
+                    email="new@example.com",
+                    version=0,
+                )
+            )
+            return list(
+                sync_connection.execute(sa.select(table.c.bio).order_by(table.c.id))
+                .scalars()
+                .all()
+            )
+
+        bios = await connection.run_sync(read_bios)
+        await connection.run_sync(run_downgrade)
+        columns_after_downgrade = await connection.run_sync(
+            lambda sync_connection: {
+                column["name"]
+                for column in sa.inspect(sync_connection).get_columns("users")
+            }
+        )
+
+    await engine.dispose()
+    assert bios == ["", ""]
+    assert "bio" not in columns_after_downgrade
