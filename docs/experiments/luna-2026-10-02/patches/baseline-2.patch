+"""Tests for the Update User Profile use case."""
+
+import pytest
+from flow_res import is_err, is_ok
+from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.repositories import RepositoryErrorType
+from app.domain.value_objects import DisplayName, Email, UserId
+from app.infrastructure.unit_of_work import SQLAlchemyUnitOfWork
+from app.usecases.result import ErrorType
+from app.usecases.users.update_user_profile import (
+    UpdateUserProfileCommand,
+    UpdateUserProfileHandler,
+)
+
+
+@pytest.mark.anyio
+async def test_update_user_profile_persists_both_values_across_uows(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Profile data persists and is readable from an independent UoW."""
+    user = User.register(DisplayName("Alice"), Email("alice@example.com"))
+    async with uow:
+        repository = uow.GetRepository(User)
+        added = await repository.add(user)
+        assert is_ok(added)
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Alice Cooper",
+            bio="  musician\nfrom Sheffield  ",
+        )
+    )
+    assert is_ok(result)
+    assert result.value.id == user.id.to_primitive()
+
+    second_uow = SQLAlchemyUnitOfWork(session_factory)
+    async with second_uow:
+        repository = second_uow.GetRepository(User, UserId)
+        saved = await repository.get_by_id(user.id)
+        assert is_ok(saved)
+        assert saved.value.display_name.to_primitive() == "Alice Cooper"
+        assert saved.value.bio.to_primitive() == "  musician\nfrom Sheffield  "
+        assert saved.value.email.to_primitive() == "alice@example.com"
+
+
+@pytest.mark.anyio
+async def test_update_user_profile_rejects_invalid_inputs_without_saving(
+    uow: IUnitOfWork,
+) -> None:
+    """Invalid profile fields do not persist even a valid companion field."""
+    user = User.register(DisplayName("Alice"), Email("alice@example.com"))
+    async with uow:
+        repository = uow.GetRepository(User)
+        added = await repository.add(user)
+        assert is_ok(added)
+        assert is_ok(await uow.commit())
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Valid new name",
+            bio="x" * 501,
+        )
+    )
+    assert is_err(result)
+    assert result.error.type == ErrorType.VALIDATION_ERROR
+
+    async with uow:
+        repository = uow.GetRepository(User, UserId)
+        saved = await repository.get_by_id(user.id)
+        assert is_ok(saved)
+        assert saved.value.display_name.to_primitive() == "Alice"
+        assert saved.value.bio.to_primitive() == ""
+
+
+@pytest.mark.anyio
+async def test_update_user_profile_unknown_id_does_not_create_user(
+    uow: IUnitOfWork,
+) -> None:
+    """A valid profile update for a missing ID returns the existing not-found error."""
+    user_id = UserId.generate().expect("valid ID")
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user_id.to_primitive(), display_name="Alice", bio="new bio"
+        )
+    )
+    assert is_err(result)
+    assert result.error.type == RepositoryErrorType.NOT_FOUND
+
+    async with uow:
+        repository = uow.GetRepository(User, UserId)
+        assert is_err(await repository.get_by_id(user_id))
+
+
+@pytest.mark.anyio
+async def test_profile_write_failure_does_not_commit_either_field(
+    uow: IUnitOfWork,
+    session_factory: async_sessionmaker[AsyncSession],
+    database_engine: AsyncEngine,
+) -> None:
+    """A database write failure rolls back both requested profile values."""
+    user = User.register(DisplayName("Alice"), Email("alice@example.com"))
+    async with uow:
+        repository = uow.GetRepository(User)
+        added = await repository.add(user)
+        assert is_ok(added)
+        assert is_ok(await uow.commit())
+
+    async with database_engine.begin() as connection:
+        await connection.exec_driver_sql(
+            "CREATE TRIGGER reject_user_update BEFORE UPDATE ON users "
+            "BEGIN SELECT RAISE(ABORT, 'test write failure'); END"
+        )
+
+    result = await UpdateUserProfileHandler(uow).handle(
+        UpdateUserProfileCommand(
+            user_id=user.id.to_primitive(),
+            display_name="Changed name",
+            bio="Changed bio",
+        )
+    )
+    assert is_err(result)
+
+    second_uow = SQLAlchemyUnitOfWork(session_factory)
+    async with second_uow:
+        repository = second_uow.GetRepository(User, UserId)
+        saved = await repository.get_by_id(user.id)
+        assert is_ok(saved)
+        assert saved.value.display_name.to_primitive() == "Alice"
+        assert saved.value.bio.to_primitive() == ""
