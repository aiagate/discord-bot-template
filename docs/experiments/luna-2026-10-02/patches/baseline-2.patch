+    """PUT sends both profile values and returns the user ID."""
+    send_async = AsyncMock(return_value=Ok(UpdateUserProfileResult(id="user-1")))
+    mediator_mock = cast(ApplicationMediator, Mock(send_async=send_async))
+
+    response = await update_user_profile(
+        "user-1",
+        UpdateUserProfileRequest(display_name="Alice", bio="  hi\nthere  "),
+        mediator_mock,
+    )
+
+    assert response.id == "user-1"
+    send_async.assert_awaited_once_with(
+        UpdateUserProfileCommand(
+            user_id="user-1", display_name="Alice", bio="  hi\nthere  "
