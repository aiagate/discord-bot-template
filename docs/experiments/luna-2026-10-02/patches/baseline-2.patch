+"""Tests for UserBio validation and string preservation."""
+
+import pytest
+from flow_res import is_err, is_ok
+
+from app.domain.value_objects import UserBio
+
+
+def test_user_bio_accepts_empty_and_preserves_whitespace() -> None:
+    """Empty bios and whitespace/newline content are retained as supplied."""
+    assert UserBio("").to_primitive() == ""
+    value = "  first line\nsecond line\t "
+    assert UserBio(value).to_primitive() == value
+
+
+def test_user_bio_accepts_exactly_500_characters() -> None:
+    """The maximum supported biography length is inclusive."""
+    assert len(UserBio("x" * 500).to_primitive()) == 500
+
+
+def test_user_bio_rejects_more_than_500_characters() -> None:
+    """An oversized biography is rejected by the value object."""
+    result = UserBio.from_primitive("x" * 501)
+    assert is_err(result)
+    assert "500" in str(result.error)
+
+
+def test_user_bio_direct_constructor_rejects_oversized_value() -> None:
+    """Direct domain construction enforces the same maximum as the factory."""
+    with pytest.raises(ValueError, match="500"):
+        UserBio("x" * 501)
+
+
+def test_user_bio_factory_accepts_valid_value() -> None:
+    """The factory returns a valid UserBio result."""
+    result = UserBio.from_primitive("about me")
+    assert is_ok(result)
+    assert result.value == UserBio("about me")
diff --git a/tests/infrastructure/test_user_bio_migration.py b/tests/infrastructure/test_user_bio_migration.py
new file mode 100644
index 0000000..2bfffce
--- /dev/null
+++ b/tests/infrastructure/test_user_bio_migration.py
@@ -0,0 +1,80 @@
+"""Tests for migrating the biography column onto existing users."""
+
+import importlib.util
+from pathlib import Path
+from typing import Any
+
+import pytest
+import sqlalchemy as sa
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy.ext.asyncio import create_async_engine
+
+_MIGRATION_PATH = (
+    Path(__file__).parents[2]
+    / "alembic"
+    / "versions"
+    / "202610021200_add_bio_to_users.py"
+)
+
+
+def _load_migration() -> Any:
+    spec = importlib.util.spec_from_file_location("user_bio_migration", _MIGRATION_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("Could not load user biography migration.")
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    return migration
+
+
+@pytest.mark.anyio
+async def test_existing_users_receive_empty_bio_and_migration_is_reversible() -> None:
+    """The schema upgrade preserves old rows and initializes bio to empty."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+    metadata = sa.MetaData()
+    users = sa.Table(
+        "users",
+        metadata,
+        sa.Column("id", sa.String(26), primary_key=True),
+        sa.Column("display_name", sa.String(255), nullable=False),
+        sa.Column("email", sa.String(255), nullable=False),
+    )
+    migration = _load_migration()
+
+    async with engine.begin() as connection:
+        await connection.run_sync(metadata.create_all)
+        await connection.execute(
+            users.insert(),
+            {
+                "id": "legacy-user",
+                "display_name": "Legacy",
+                "email": "legacy@example.com",
+            },
+        )
+
+        def upgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.upgrade()
+
+        def downgrade(sync_connection: sa.Connection) -> None:
+            context = MigrationContext.configure(sync_connection)
+            with Operations.context(context):
+                migration.downgrade()
+
+        await connection.run_sync(upgrade)
+        bio = await connection.scalar(
+            sa.text("SELECT bio FROM users WHERE id = 'legacy-user'")
+        )
+        assert bio == ""
+
+        await connection.run_sync(downgrade)
+        remaining_columns = await connection.run_sync(
+            lambda sync_connection: {
+                column["name"]
+                for column in sa.inspect(sync_connection).get_columns("users")
+            }
+        )
+        assert "bio" not in remaining_columns
+
+    await engine.dispose()
