diff --git a/src/app/domain/value_objects/user_bio.py b/src/app/domain/value_objects/user_bio.py
new file mode 100644
index 0000000..d753930
--- /dev/null
+++ b/src/app/domain/value_objects/user_bio.py
@@ -0,0 +1,38 @@
+"""Bio value object with length validation and exact string preservation."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+from flow_res import Err, Ok, Result
+
+
+@dataclass(frozen=True)
+class UserBio:
+    """A user's biography, preserving all whitespace and line breaks."""
+
+    _value: str
+
+    MAX_LENGTH: ClassVar[int] = 500
+
+    def __post_init__(self) -> None:
+        """Reject non-string values and biographies longer than 500 characters."""
+        if not isinstance(  # type: ignore[reportUnnecessaryIsInstance]
+            self._value, str
+        ):
+            raise TypeError("Bio must be a string.")
+        if len(self._value) > self.MAX_LENGTH:
+            raise ValueError(f"Bio must not exceed {self.MAX_LENGTH} characters.")
+
+    def to_primitive(self) -> str:
+        """Return the biography string unchanged."""
+        return self._value
+
+    @classmethod
+    def from_primitive(cls, value: str) -> Result[UserBio, Exception]:
+        """Validate a primitive biography string."""
+        try:
+            return Ok(cls(value))
+        except (TypeError, ValueError) as error:
+            return Err(error)
diff --git a/src/app/usecases/users/update_user_profile.py b/src/app/usecases/users/update_user_profile.py
new file mode 100644
index 0000000..fb29ab5
--- /dev/null
+++ b/src/app/usecases/users/update_user_profile.py
@@ -0,0 +1,80 @@
+"""Update an existing user's profile."""
+
+from dataclasses import dataclass
+
+from flow_med import Request, RequestHandler
+from flow_res import Err, Ok, Result, combine_all, is_err
+from injector import inject
+
+from app.contracts.ports import IUnitOfWork
+from app.domain.aggregates.user import User
+from app.domain.value_objects import DisplayName, UserBio, UserId
+from app.usecases.result import ErrorType, UseCaseError, UseCaseResultError
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileResult:
+    """Result of a successful user profile update."""
+
+    id: str
+
+
+@dataclass(frozen=True)
+class UpdateUserProfileCommand(
+    Request[Result[UpdateUserProfileResult, UseCaseResultError]]
+):
+    """Replace the display name and bio for an existing user."""
+
+    user_id: str
+    display_name: str
+    bio: str
+
+
+class UpdateUserProfileHandler(
+    RequestHandler[
+        UpdateUserProfileCommand,
+        Result[UpdateUserProfileResult, UseCaseResultError],
+    ]
+):
+    """Handler for updating a user's profile."""
+
+    @inject
+    def __init__(self, uow: IUnitOfWork) -> None:
+        self._uow = uow
+
+    async def handle(
+        self, request: UpdateUserProfileCommand
+    ) -> Result[UpdateUserProfileResult, UseCaseResultError]:
+        """Validate, update, and commit both profile fields atomically."""
+        values = combine_all(
+            (
+                UserId.from_primitive(request.user_id),
+                DisplayName.from_primitive(request.display_name),
+                UserBio.from_primitive(request.bio),
+            )
+        ).map_err(
+            lambda error: UseCaseError(
+                type=ErrorType.VALIDATION_ERROR,
+                message=", ".join(str(exc) for exc in error.exceptions),
+            )
+        )
+        if is_err(values):
+            return Err(values.error)
+
+        user_id, display_name, bio = values.unwrap()
+        async with self._uow:
+            repository = self._uow.GetRepository(User, UserId)
+            user_result = await repository.get_by_id(user_id)
+            if is_err(user_result):
+                return Err(user_result.error)
+
+            user = user_result.value.change_profile(display_name, bio)
+            update_result = await repository.update(user)
+            if is_err(update_result):
+                return Err(update_result.error)
+
+            commit_result = await self._uow.commit()
+            if is_err(commit_result):
+                return Err(commit_result.error)
+
+        return Ok(UpdateUserProfileResult(id=user_id.to_primitive()))
