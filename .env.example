# Discord Bot Token
DISCORD_BOT_TOKEN=

#LINE Messaging API Key
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Optional AI responses in configured webhook destinations. Requires a Gemini key,
# a guild ID, and at least one valid webhook URL in the JSON array.
# For production, install/run with --extra ai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# JSON array of webhook URLs. Multiple text/forum destinations are supported.
# Example: DISCORD_CHARACTER_WEBHOOK_URLS_JSON='["https://discord.com/api/webhooks/..."]'
DISCORD_CHARACTER_WEBHOOK_URLS_JSON=
DISCORD_CHARACTER_GUILD_ID=
# Single webhook URL for the Times (AI maid bulletin board) text channel destination.
DISCORD_CHARACTER_TIMES_WEBHOOK_URL=
# Optional override file; relative paths are based on the repository root.
# Default: characters.override.json in the repository root, if present.
CHARACTER_DEFINITIONS_PATH=
# Directory for per-character Markdown memory and selection summaries.
CHARACTER_MEMORY_ROOT=memory/characters

# Event bus provider for multi-process operation
# EVENT_BUS_PROVIDER=redis
# REDIS_URL=redis://localhost:6379/0
