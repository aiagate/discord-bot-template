# Discord Bot Token
DISCORD_BOT_TOKEN=

#LINE Messaging API Key
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Optional AI responses in configured webhook destinations. Requires a Gemini key,
# a guild ID, and at least one valid webhook URL in the JSON array.
# For production, install/run with --extra ai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# JSON array of webhook URLs. Multiple text/forum destinations are supported.
# Example: DISCORD_CHARACTER_WEBHOOK_URLS_JSON='["https://discord.com/api/webhooks/..."]'
DISCORD_CHARACTER_WEBHOOK_URLS_JSON=
DISCORD_CHARACTER_GUILD_ID=
# Fixed master user ID; enables mentions to this user in replies and Times.
DISCORD_CHARACTER_MASTER_USER_ID=
# Single webhook URL for the Times (AI maid bulletin board) text channel destination.
DISCORD_CHARACTER_TIMES_WEBHOOK_URL=
# Optional override file; relative paths are based on the repository root.
# Default: characters.override.json in the repository root, if present.
CHARACTER_DEFINITIONS_PATH=
# Optional Exa MCP key used by characters.exa.example.json.
EXA_API_KEY=
# Directory for per-character Markdown memory and selection summaries.
CHARACTER_MEMORY_ROOT=memory/characters

# Optional Codex work: install/run with --extra codex. See docs/character-work.md.
# Absolute directory outside the bot repository; empty disables work.
CODEX_WORK_ROOT=
# Work reuses DISCORD_CHARACTER_GUILD_ID by default. Set this only for another guild.
# CODEX_WORK_GUILD_ID=
# Required when work is enabled: comma-separated allowed user IDs.
CODEX_WORK_USER_IDS=
# Work reuses DISCORD_CHARACTER_WEBHOOK_URLS_JSON by default. Set this only for
# different reporting destinations (one webhook per parent channel).
# CODEX_WORK_WEBHOOK_URLS_JSON='["https://discord.com/api/webhooks/..."]'
# Optional Git repository for all characters; empty uses standalone directories.
CODEX_WORK_REPOSITORY=
# Optional Codex model override; empty uses Codex default.
CODEX_WORK_MODEL=
# Per-turn timeout in seconds (default: 1200).
CODEX_WORK_TIMEOUT_SECONDS=1200
